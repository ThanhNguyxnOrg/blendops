{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ThanhNguyxnOrg/blendops/schemas/runtime-capability-policy.schema.json",
  "title": "BlendOps Runtime Capability & Scene Rollback Policy Schema",
  "description": "Formal L0-L3 runtime capability tiering, non-escalation rules, and pre-mutation .blend checkpoint/rollback requirements across the 48-skill BlendOps catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "defaultCapabilityTier",
    "runtimeExecutionState",
    "tiers",
    "rollbackProtocol",
    "skills"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "defaultCapabilityTier": {
      "const": "L0"
    },
    "runtimeExecutionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blenderRuntime",
        "liveRollbackEngineExecuted",
        "honestyNote"
      ],
      "properties": {
        "blenderRuntime": {
          "const": "Not Run"
        },
        "liveRollbackEngineExecuted": {
          "const": false
        },
        "honestyNote": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["L0", "L1", "L2", "L3"],
      "properties": {
        "L0": { "$ref": "#/$defs/tierSpec" },
        "L1": { "$ref": "#/$defs/tierSpec" },
        "L2": { "$ref": "#/$defs/tierSpec" },
        "L3": { "$ref": "#/$defs/tierSpec" }
      }
    },
    "rollbackProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpointPattern",
        "requiredBackupFields",
        "failClosedOnBackupFailure",
        "recoveryVerificationTools",
        "postRecoveryTruthRule"
      ],
      "properties": {
        "checkpointPattern": {
          "type": "string",
          "minLength": 10
        },
        "requiredBackupFields": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "failClosedOnBackupFailure": {
          "const": true
        },
        "recoveryVerificationTools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path1", "path2"],
          "properties": {
            "path1": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "path2": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          }
        },
        "postRecoveryTruthRule": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skillId",
          "capabilityTier",
          "governedRuntimeCeiling",
          "requiresPreMutationBackupWhenExecuted",
          "requiresAssetLicenseClearance",
          "requiresExplicitOperatorConfirmation",
          "userFacingPythonAllowed"
        ],
        "properties": {
          "skillId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "capabilityTier": {
            "type": "string",
            "enum": ["L0", "L1", "L2", "L3"]
          },
          "governedRuntimeCeiling": {
            "type": "string",
            "enum": ["L0", "L1", "L2", "L3"]
          },
          "requiresPreMutationBackupWhenExecuted": {
            "type": "boolean"
          },
          "requiresAssetLicenseClearance": {
            "type": "boolean"
          },
          "requiresExplicitOperatorConfirmation": {
            "type": "boolean"
          },
          "userFacingPythonAllowed": {
            "const": false
          }
        }
      }
    }
  },
  "$defs": {
    "tierSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rank",
        "name",
        "summary",
        "allowSceneMutation",
        "allowFileExport",
        "allowExternalAssetImport",
        "allowArbitraryCodeExecution",
        "requiresPreMutationBlendBackup",
        "requiresExplicitOperatorConfirmation",
        "requiresAssetLicenseClearance",
        "userFacingPythonAllowed"
      ],
      "properties": {
        "id": { "type": "string", "enum": ["L0", "L1", "L2", "L3"] },
        "rank": { "type": "integer", "minimum": 0, "maximum": 3 },
        "name": { "type": "string", "minLength": 5 },
        "summary": { "type": "string", "minLength": 10 },
        "allowSceneMutation": { "type": "boolean" },
        "allowFileExport": { "type": "boolean" },
        "allowExternalAssetImport": { "type": "boolean" },
        "allowArbitraryCodeExecution": { "type": "boolean" },
        "requiresPreMutationBlendBackup": { "type": "boolean" },
        "requiresExplicitOperatorConfirmation": { "type": "boolean" },
        "requiresAssetLicenseClearance": { "type": "boolean" },
        "userFacingPythonAllowed": { "const": false }
      }
    }
  }
}
