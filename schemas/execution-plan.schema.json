{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ThanhNguyxnOrg/blendops/schemas/execution-plan.schema.json",
  "title": "BlendOps Deterministic ExecutionPlan",
  "description": "Harmonized, conflict-checked execution plan compiled from a SceneSpec, canonical skills, and shared knowledge/recipe catalogs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "scene_spec_id",
    "scene_spec_title",
    "status",
    "can_proceed_to_runtime",
    "blender_version_target",
    "runtime_preference",
    "precedence_hierarchy",
    "recipe_resolution",
    "stages",
    "resolved_skills",
    "resolved_knowledge",
    "parameter_decisions",
    "conflicts",
    "conflict_summary",
    "stage_gates",
    "required_evidence_packets",
    "truth_states"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^plan\\.[a-z0-9-]+$"
    },
    "scene_spec_id": {
      "type": "string",
      "pattern": "^scene-spec\\.[a-z0-9-]+$"
    },
    "scene_spec_title": {
      "type": "string",
      "minLength": 5
    },
    "status": {
      "type": "string",
      "enum": ["ready", "ready_with_warnings", "blocked"]
    },
    "can_proceed_to_runtime": {
      "type": "boolean"
    },
    "blender_version_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "tested_range", "recommended"],
      "properties": {
        "min": { "type": "string" },
        "tested_range": { "type": "string" },
        "recommended": { "type": "string" }
      }
    },
    "runtime_preference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferred_path", "allow_cli_fallback", "selected_runtime_skill"],
      "properties": {
        "preferred_path": { "type": "string" },
        "allow_cli_fallback": { "type": "boolean" },
        "selected_runtime_skill": { "type": "string" }
      }
    },
    "precedence_hierarchy": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "layer_id", "name", "description"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1, "maximum": 8 },
          "layer_id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "recipe_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_recipe_id",
        "supporting_recipe_ids",
        "selection_rationale",
        "decomposed_sub_goals"
      ],
      "properties": {
        "primary_recipe_id": {
          "type": "string",
          "pattern": "^recipe\\.[a-z0-9-]+$"
        },
        "supporting_recipe_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^recipe\\.[a-z0-9-]+$"
          }
        },
        "selection_rationale": {
          "type": "string",
          "minLength": 10
        },
        "decomposed_sub_goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step_index", "recipe_id", "sub_goal", "skills", "knowledge_refs"],
            "properties": {
              "step_index": { "type": "integer", "minimum": 1 },
              "recipe_id": { "type": "string" },
              "sub_goal": { "type": "string" },
              "skills": { "type": "array", "items": { "type": "string" } },
              "knowledge_refs": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage_index",
          "stage_id",
          "stage_name",
          "skills",
          "knowledge_refs",
          "entry_criteria",
          "exit_gate"
        ],
        "properties": {
          "stage_index": { "type": "integer", "minimum": 1, "maximum": 7 },
          "stage_id": {
            "type": "string",
            "enum": ["discover", "define", "plan", "source", "execute", "verify", "deliver"]
          },
          "stage_name": { "type": "string" },
          "skills": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "knowledge_refs": { "type": "array", "items": { "type": "string" } },
          "entry_criteria": { "type": "string" },
          "exit_gate": { "type": "string" }
        }
      }
    },
    "resolved_skills": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "resolved_knowledge": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "domain", "authority_level", "blender_versions"],
        "properties": {
          "id": { "type": "string", "pattern": "^knowledge\\.[a-z0-9-]+$" },
          "title": { "type": "string" },
          "domain": { "type": "string" },
          "authority_level": { "type": "string" },
          "blender_versions": { "type": "object" }
        }
      }
    },
    "parameter_decisions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parameter",
          "selected_value",
          "winning_layer_rank",
          "winning_layer_id",
          "governing_id",
          "rationale"
        ],
        "properties": {
          "parameter": { "type": "string" },
          "selected_value": { "type": ["string", "number", "boolean"] },
          "winning_layer_rank": { "type": "integer", "minimum": 1, "maximum": 8 },
          "winning_layer_id": { "type": "string" },
          "governing_id": { "type": "string" },
          "rationale": { "type": "string" }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conflict_id",
          "severity",
          "rule_id",
          "winning_layer_rank",
          "winning_layer_id",
          "losing_layer_id",
          "summary",
          "affected_skills",
          "knowledge_refs",
          "remediation"
        ],
        "properties": {
          "conflict_id": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["blocking", "warning", "informational"]
          },
          "rule_id": { "type": "string" },
          "winning_layer_rank": { "type": "integer", "minimum": 1, "maximum": 8 },
          "winning_layer_id": { "type": "string" },
          "losing_layer_id": { "type": "string" },
          "summary": { "type": "string" },
          "affected_skills": {
            "type": "array",
            "items": { "type": "string" }
          },
          "knowledge_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "remediation": { "type": "string" }
        }
      }
    },
    "conflict_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocking_count", "warning_count", "informational_count", "total_count"],
      "properties": {
        "blocking_count": { "type": "integer", "minimum": 0 },
        "warning_count": { "type": "integer", "minimum": 0 },
        "informational_count": { "type": "integer", "minimum": 0 },
        "total_count": { "type": "integer", "minimum": 0 }
      }
    },
    "stage_gates": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "stage_id", "skill_id", "criterion", "blocking"],
        "properties": {
          "gate_id": { "type": "string" },
          "stage_id": { "type": "string" },
          "skill_id": { "type": "string" },
          "criterion": { "type": "string" },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "required_evidence_packets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packet_type",
          "governing_skill",
          "schema_ref",
          "required_before_claim",
          "default_truth_state"
        ],
        "properties": {
          "packet_type": {
            "type": "string",
            "enum": ["runtime-smoke", "preview-check", "render-export", "glb-handoff"]
          },
          "governing_skill": { "type": "string" },
          "schema_ref": { "type": "string" },
          "required_before_claim": { "type": "string" },
          "default_truth_state": {
            "type": "string",
            "enum": ["Not Run", "Not Produced"]
          }
        }
      }
    },
    "truth_states": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_status", "artifact_status", "evidence_gate_enforced"],
      "properties": {
        "runtime_status": {
          "type": "string",
          "const": "Not Run"
        },
        "artifact_status": {
          "type": "string",
          "const": "Not Produced"
        },
        "evidence_gate_enforced": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
