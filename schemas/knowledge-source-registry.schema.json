{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ThanhNguyxnOrg/blendops/schemas/knowledge-source-registry.schema.json",
  "title": "BlendOps Knowledge & Recipe Source Registry and Controlled Taxonomy Schema (v1.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "taxonomy",
    "sources"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../schemas/knowledge-source-registry.schema.json"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains",
        "knowledgeKinds",
        "evidenceStatuses",
        "sourceAuthorities",
        "supportedBlenderVersions"
      ],
      "properties": {
        "domains": {
          "type": "array",
          "minItems": 11,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "description"],
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "modeling-and-topology",
                  "hard-surface-and-organic",
                  "geometry-nodes-and-procedural",
                  "uv-texturing-and-baking",
                  "materials-shaders-and-pbr",
                  "lighting-camera-and-rendering",
                  "rigging-and-animation",
                  "simulation-and-vfx",
                  "environment-and-architecture",
                  "optimization-lod-and-performance",
                  "interchange-gltf-and-web"
                ]
              },
              "title": { "type": "string", "minLength": 5, "maxLength": 100 },
              "description": { "type": "string", "minLength": 20, "maxLength": 300 }
            }
          }
        },
        "knowledgeKinds": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "topology-rule",
              "modeling-workflow",
              "procedural-system",
              "uv-baking-rule",
              "material-shader-profile",
              "lighting-camera-rule",
              "render-engine-profile",
              "rigging-animation-rule",
              "simulation-vfx-profile",
              "scene-assembly-pattern",
              "performance-budget-rule",
              "interchange-export-rule"
            ]
          }
        },
        "evidenceStatuses": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "authored",
              "source-reviewed",
              "version-checked",
              "runtime-tested"
            ]
          }
        },
        "sourceAuthorities": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "official-specification",
              "official-product-manual",
              "official-production-pipeline",
              "peer-reviewed-research",
              "reference-implementation",
              "community-practice",
              "blendops-internal-evaluation",
              "official-manual",
              "official-pipeline"
            ]
          }
        },
        "supportedBlenderVersions": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "3.0+",
              "3.6 LTS",
              "4.0+",
              "4.2 LTS",
              "4.5 LTS",
              "4.5.15 LTS",
              "5.1+",
              "5.2 LTS",
              "5.2.3 LTS"
            ]
          }
        },
        "versionBaseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "latest_stable_lts",
            "maintained_lts_versions",
            "legacy_compatibility_target",
            "upcoming_unreleased_note",
            "gltf_specification_version",
            "path_1_lab_mcp_floor",
            "path_2_community_mcp_floor"
          ],
          "properties": {
            "latest_stable_lts": { "type": "string", "const": "5.2.3 LTS" },
            "maintained_lts_versions": {
              "type": "array",
              "minItems": 2,
              "items": { "type": "string" }
            },
            "legacy_compatibility_target": { "type": "string" },
            "upcoming_unreleased_note": { "type": "string" },
            "gltf_specification_version": { "type": "string", "const": "2.0.1" },
            "path_1_lab_mcp_floor": { "type": "string", "const": "5.1+" },
            "path_2_community_mcp_floor": { "type": "string", "const": "3.0+" }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "authority",
          "organization",
          "publisher",
          "url",
          "locator_or_section",
          "version_or_date",
          "verification_date",
          "verification_status",
          "url_verified",
          "claim_verification_scope",
          "license_note",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^source\\.[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "minLength": 5,
            "maxLength": 180
          },
          "authority": {
            "type": "string",
            "enum": [
              "official-specification",
              "official-product-manual",
              "official-production-pipeline",
              "peer-reviewed-research",
              "reference-implementation",
              "community-practice",
              "blendops-internal-evaluation"
            ]
          },
          "organization": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "publisher": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "locator_or_section": {
            "type": "string",
            "minLength": 3,
            "maxLength": 220
          },
          "version_or_date": {
            "type": "string",
            "minLength": 4,
            "maxLength": 80
          },
          "verification_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "verified-reference",
              "specification-standard",
              "architectural-reference"
            ]
          },
          "url_verified": {
            "type": "boolean"
          },
          "claim_verification_scope": {
            "type": "string",
            "minLength": 10,
            "maxLength": 280
          },
          "license_note": {
            "type": "string",
            "minLength": 3,
            "maxLength": 180
          },
          "summary": {
            "type": "string",
            "minLength": 20,
            "maxLength": 420
          }
        }
      }
    }
  }
}
