{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ThanhNguyxnOrg/blendops/schemas/knowledge-source-registry.schema.json",
  "title": "BlendOps Knowledge & Recipe Source Registry and Controlled Taxonomy Schema (v1.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "taxonomy",
    "sources"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../schemas/knowledge-source-registry.schema.json"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains",
        "knowledgeKinds",
        "evidenceStatuses",
        "sourceAuthorities",
        "supportedBlenderVersions"
      ],
      "properties": {
        "domains": {
          "type": "array",
          "minItems": 11,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "description"],
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "modeling-and-topology",
                  "hard-surface-and-organic",
                  "geometry-nodes-and-procedural",
                  "uv-texturing-and-baking",
                  "materials-shaders-and-pbr",
                  "lighting-camera-and-rendering",
                  "rigging-and-animation",
                  "simulation-and-vfx",
                  "environment-and-architecture",
                  "optimization-lod-and-performance",
                  "interchange-gltf-and-web"
                ]
              },
              "title": { "type": "string", "minLength": 5, "maxLength": 100 },
              "description": { "type": "string", "minLength": 20, "maxLength": 300 }
            }
          }
        },
        "knowledgeKinds": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "topology-rule",
              "modeling-workflow",
              "procedural-system",
              "uv-baking-rule",
              "material-shader-profile",
              "lighting-camera-rule",
              "render-engine-profile",
              "rigging-animation-rule",
              "simulation-vfx-profile",
              "scene-assembly-pattern",
              "performance-budget-rule",
              "interchange-export-rule"
            ]
          }
        },
        "evidenceStatuses": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "authored",
              "source-reviewed",
              "version-checked",
              "runtime-tested"
            ]
          }
        },
        "sourceAuthorities": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "official-specification",
              "official-manual",
              "official-pipeline",
              "peer-reviewed-research",
              "reference-implementation"
            ]
          }
        },
        "supportedBlenderVersions": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "3.0+",
              "3.6 LTS",
              "4.0+",
              "4.2 LTS",
              "5.1+"
            ]
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "authority",
          "organization",
          "url",
          "version_or_date",
          "verification_status",
          "license_note",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^source\\.[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "minLength": 5,
            "maxLength": 180
          },
          "authority": {
            "type": "string",
            "enum": [
              "official-specification",
              "official-manual",
              "official-pipeline",
              "peer-reviewed-research",
              "reference-implementation"
            ]
          },
          "organization": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          },
          "version_or_date": {
            "type": "string",
            "minLength": 4,
            "maxLength": 64
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "verified-reference",
              "specification-standard",
              "architectural-reference"
            ]
          },
          "license_note": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          },
          "summary": {
            "type": "string",
            "minLength": 20,
            "maxLength": 400
          }
        }
      }
    }
  }
}
