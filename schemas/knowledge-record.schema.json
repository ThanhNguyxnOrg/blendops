{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ThanhNguyxnOrg/blendops/schemas/knowledge-record.schema.json",
  "title": "BlendOps Knowledge Catalog Schema (v1.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "records"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../schemas/knowledge-record.schema.json"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "records": {
      "type": "array",
      "minItems": 25,
      "items": {
        "$ref": "#/$defs/knowledgeRecord"
      }
    }
  },
  "$defs": {
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator"],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^source\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "locator": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        }
      }
    },
    "claimEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "scope", "source_refs"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^claim\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "statement": {
          "type": "string",
          "minLength": 20,
          "maxLength": 400
        },
        "scope": {
          "type": "string",
          "minLength": 10,
          "maxLength": 220
        },
        "uncertainty_or_version_note": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceReference"
          }
        }
      }
    },
    "observableCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "check", "pass_condition", "fail_indicator"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^check\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "check": {
          "type": "string",
          "minLength": 10,
          "maxLength": 240
        },
        "pass_condition": {
          "type": "string",
          "minLength": 10,
          "maxLength": 240
        },
        "fail_indicator": {
          "type": "string",
          "minLength": 10,
          "maxLength": 240
        }
      }
    },
    "knowledgeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "domain",
        "kind",
        "summary",
        "aliases",
        "intent_signals",
        "applicability",
        "prerequisites",
        "principles",
        "implementation_guidance",
        "observable_checks",
        "creative_affordances",
        "known_limits",
        "claims",
        "source_refs",
        "related_ids",
        "blender_versions",
        "evidence_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^knowledge\\.[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 12,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 8,
          "maxLength": 140
        },
        "domain": {
          "type": "string",
          "enum": [
            "modeling-and-topology",
            "hard-surface-and-organic",
            "geometry-nodes-and-procedural",
            "uv-texturing-and-baking",
            "materials-shaders-and-pbr",
            "lighting-camera-and-rendering",
            "rigging-and-animation",
            "simulation-and-vfx",
            "environment-and-architecture",
            "optimization-lod-and-performance",
            "interchange-gltf-and-web"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "topology-rule",
            "modeling-workflow",
            "procedural-system",
            "uv-baking-rule",
            "material-shader-profile",
            "lighting-camera-rule",
            "render-engine-profile",
            "rigging-animation-rule",
            "simulation-vfx-profile",
            "scene-assembly-pattern",
            "performance-budget-rule",
            "interchange-export-rule"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 35,
          "maxLength": 360
        },
        "aliases": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          }
        },
        "intent_signals": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 4,
            "maxLength": 140
          }
        },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "when_to_apply",
            "when_not_to_apply",
            "target_representations"
          ],
          "properties": {
            "when_to_apply": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 10, "maxLength": 280 }
            },
            "when_not_to_apply": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 10, "maxLength": 280 }
            },
            "target_representations": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "subdivision-mesh",
                  "polygon-game-mesh",
                  "hard-surface-mesh",
                  "sculpt-highpoly",
                  "geometry-nodes-graph",
                  "uv-layout",
                  "pbr-material-graph",
                  "lighting-camera-rig",
                  "skeletal-armature",
                  "simulation-cache",
                  "scene-hierarchy",
                  "glb-container"
                ]
              }
            }
          }
        },
        "prerequisites": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 240
          }
        },
        "principles": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 20,
            "maxLength": 420
          }
        },
        "implementation_guidance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workflow_steps",
            "recommended_parameters",
            "blender_context"
          ],
          "properties": {
            "workflow_steps": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 15,
                "maxLength": 380
              }
            },
            "recommended_parameters": {
              "type": "object",
              "minProperties": 2,
              "additionalProperties": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "number" },
                  { "type": "boolean" }
                ]
              }
            },
            "blender_context": {
              "type": "string",
              "minLength": 15,
              "maxLength": 340
            }
          }
        },
        "observable_checks": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/observableCheck"
          }
        },
        "creative_affordances": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 15,
            "maxLength": 280
          }
        },
        "known_limits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 15,
            "maxLength": 320
          }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claimEntry"
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceReference"
          }
        },
        "related_ids": {
          "type": "object",
          "additionalProperties": false,
          "required": ["knowledge_ids", "skill_ids", "recipe_ids"],
          "properties": {
            "knowledge_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^knowledge\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            },
            "skill_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              }
            },
            "recipe_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^recipe\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            }
          }
        },
        "blender_versions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "tested_or_targeted", "version_notes"],
          "properties": {
            "minimum": {
              "type": "string",
              "enum": ["3.0+", "3.6 LTS", "4.0+", "4.2 LTS", "5.1+"]
            },
            "tested_or_targeted": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["3.0+", "3.6 LTS", "4.0+", "4.2 LTS", "5.1+"]
              }
            },
            "version_notes": {
              "type": "string",
              "minLength": 10,
              "maxLength": 320
            }
          }
        },
        "evidence_status": {
          "type": "string",
          "enum": [
            "authored",
            "source-reviewed",
            "version-checked",
            "runtime-tested"
          ]
        },
        "evidence_packet_path": {
          "type": "string",
          "pattern": "^docs/evals/[a-z0-9._-]+\\.md$"
        },
        "promoted_from_skill_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(skills/[a-z0-9-]+/references/[a-z0-9-]+\\.md|docs/[a-z0-9/_.-]+\\.md|scripts/[a-z0-9-]+\\.mjs)$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_status": { "const": "runtime-tested" }
            },
            "required": ["evidence_status"]
          },
          "then": {
            "required": ["evidence_packet_path"]
          }
        }
      ]
    }
  }
}
