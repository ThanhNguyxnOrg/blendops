{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ThanhNguyxnOrg/blendops/schemas/skill-contract.schema.json",
  "title": "BlendOps Skill Contract Schema (v1.0.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "version",
    "category",
    "role",
    "purpose",
    "routingPrecedence",
    "triggers",
    "exclusions",
    "inputs",
    "outputs",
    "handoffs"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../../schemas/skill-contract.schema.json"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "category": {
      "type": "string",
      "enum": [
        "routing-and-governance",
        "process-discipline",
        "asset-and-sourcing",
        "scene-planners",
        "render-and-output-decisions",
        "quality-validators",
        "runtime-and-execution",
        "evidence-and-handoff"
      ]
    },
    "role": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "purpose": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200
    },
    "routingPrecedence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "rank", "activationGate"],
      "properties": {
        "group": {
          "type": "string",
          "enum": ["entry-and-stage-routing", "domain-specialist"]
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "activationGate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "goalClarity",
            "recipeSelected",
            "preflightPassed",
            "hasStageOrArtifactInventory"
          ],
          "properties": {
            "goalClarity": {
              "type": "string",
              "enum": ["ambiguous_or_mixed", "clear", "any"]
            },
            "recipeSelected": {
              "type": "boolean"
            },
            "preflightPassed": {
              "type": "boolean"
            },
            "hasStageOrArtifactInventory": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "triggers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 120
      }
    },
    "exclusions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition", "delegateTo", "reason"],
        "properties": {
          "condition": { "type": "string", "minLength": 5 },
          "delegateTo": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "reason": { "type": "string", "minLength": 5 }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "description"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "type": { "type": "string", "minLength": 2 },
              "description": { "type": "string", "minLength": 5 }
            }
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "description"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "type": { "type": "string", "minLength": 2 },
              "description": { "type": "string", "minLength": 5 }
            }
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "truthStatePolicy"],
      "properties": {
        "primary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "truthStatePolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtimeDefault", "artifactDefault", "mutationRule"],
          "properties": {
            "runtimeDefault": {
              "type": "string",
              "const": "Not Run"
            },
            "artifactDefault": {
              "type": "string",
              "const": "Not Produced"
            },
            "mutationRule": {
              "type": "string",
              "const": "downgrade_only"
            }
          }
        }
      }
    },
    "handoffs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "type", "label", "when"],
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "progression",
              "conditional",
              "alternative",
              "fallback",
              "retry",
              "upstream_reference",
              "boundary_delegation"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 5
          },
          "when": {
            "$ref": "#/$defs/conditionGroup"
          },
          "retryPolicy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maxAttempts", "exitCondition"],
            "properties": {
              "maxAttempts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "exitCondition": {
                "$ref": "#/$defs/conditionGroup"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "value"],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.]+$"
        },
        "operator": {
          "type": "string",
          "enum": ["equals", "not_equals", "in", "not_in", "exists"]
        },
        "value": {
          "type": ["string", "number", "boolean", "array"]
        }
      }
    },
    "conditionGroup": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/predicate" }
        },
        "any": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/predicate" }
        }
      }
    }
  }
}
