{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ThanhNguyxnOrg/blendops/schemas/adapter-compatibility-matrix.schema.json",
  "title": "BlendOps 26-Target Cross-Agent Compatibility Matrix Schema",
  "description": "Machine-readable schema for the 26-target install and adapter compatibility inventory (Workstream E4 / F-08).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "summary",
    "promotionPolicy",
    "targets"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalInstallTargets",
        "dedicatedAdapterDocs",
        "installOnlyTargets",
        "verifiedReadCount",
        "linkedOnlyCount",
        "verifiedE2eCount"
      ],
      "properties": {
        "totalInstallTargets": { "const": 26 },
        "dedicatedAdapterDocs": { "const": 6 },
        "installOnlyTargets": { "const": 20 },
        "verifiedReadCount": { "const": 2 },
        "linkedOnlyCount": { "const": 24 },
        "verifiedE2eCount": { "const": 0 }
      }
    },
    "promotionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowDocOnlyPromotion",
        "verifiedReadAllowlist",
        "rule"
      ],
      "properties": {
        "allowDocOnlyPromotion": {
          "const": false
        },
        "verifiedReadAllowlist": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["claude-code", "generic-project"]
          }
        },
        "rule": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "canonicalHostName",
          "consumerType",
          "compatibilityTier",
          "installGuidePath",
          "adapterDocPath",
          "configurationMethod",
          "availableCapabilities",
          "evidenceLevel",
          "verificationState",
          "verificationDate",
          "verificationEvidencePath",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "canonicalHostName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "consumerType": {
            "type": "string",
            "enum": [
              "chat-ui-skills-upload",
              "coding-agent-project-local",
              "local-llm-runner",
              "generic-fallback"
            ]
          },
          "compatibilityTier": {
            "type": "string",
            "enum": ["Tier 1", "Tier 2", "Tier 3"]
          },
          "installGuidePath": {
            "type": "string",
            "pattern": "^docs/install/[a-z0-9-]+\\.md$"
          },
          "adapterDocPath": {
            "type": ["string", "null"],
            "pattern": "^docs/adapters/[a-z0-9-]+\\.md$"
          },
          "configurationMethod": {
            "type": "string",
            "minLength": 10
          },
          "availableCapabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "project-local-skill-read",
                "skills-zip-upload",
                "mcp-path-1-host-a",
                "mcp-path-1-host-b",
                "mcp-path-2-community",
                "cli-appendix-execution",
                "docs-only-reference"
              ]
            }
          },
          "evidenceLevel": {
            "type": "string",
            "enum": ["verified-read", "linked-only"]
          },
          "verificationState": {
            "type": "string",
            "enum": ["Verified Read (Repo-Local)", "Not Verified"]
          },
          "verificationDate": {
            "type": "string",
            "pattern": "^(\\d{4}-\\d{2}-\\d{2}|Not Verified)$"
          },
          "verificationEvidencePath": {
            "type": ["string", "null"]
          },
          "limitations": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  }
}
