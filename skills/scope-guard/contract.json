{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "scope-guard",
  "version": "1.0.0",
  "category": "process-discipline",
  "role": "scope-creep-and-change-request-guard",
  "purpose": "Detect mid-recipe scope creep and push back constructively before the recipe drifts; require explicit user agreement before scope expansion.",
  "capabilityTier": "L0",
  "triggers": [
    "can you also",
    "while you're at it",
    "actually let's also",
    "one more thing"
  ],
  "exclusions": [
    {
      "condition": "early planning before scope is pinned",
      "delegateTo": "done-criteria",
      "reason": "use intent-to-3d-brief-writer and done-criteria"
    },
    {
      "condition": "pure brainstorming with no active recipe",
      "delegateTo": "blender-brainstorming",
      "reason": "use blender-brainstorming"
    },
    {
      "condition": "when the addition is already explicitly covered by existing gate criteria in stage-gates / acceptance-criteria-builder (verified against w",
      "delegateTo": "acceptance-criteria-builder",
      "reason": "verified against written criteria, never judged by feel"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "locked_baseline_brief",
        "type": "object",
        "description": "Currently locked 3D brief, acceptance criteria, and stop conditions"
      },
      {
        "name": "proposed_scope_change",
        "type": "string",
        "description": "Mid-workflow user request adding new deliverables, environments, animations, or scope"
      }
    ],
    "optional": [
      {
        "name": "current_workflow_stage",
        "type": "string",
        "description": "Active stage when the scope expansion was requested"
      }
    ]
  },
  "outputs": {
    "primary": [
      "scope_classification_verdict",
      "impact_on_locked_brief_and_budget",
      "defer_split_or_reopen_decision"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "intent-to-3d-brief-writer",
      "type": "upstream_reference",
      "label": "Original brief",
      "when": {
        "all": [
          {
            "field": "goal.clarity",
            "operator": "equals",
            "value": "clear"
          },
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "done-criteria",
      "type": "upstream_reference",
      "label": "Stop condition pinned beforehand / updated on expansion",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "stop_condition"
          }
        ]
      }
    },
    {
      "target": "stage-gates",
      "type": "upstream_reference",
      "label": "Per-stage gates enforced / updated on expansion",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "stage_gates"
          }
        ]
      }
    },
    {
      "target": "acceptance-criteria-builder",
      "type": "boundary_delegation",
      "label": "Measurable acceptance rows for added scope",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "acceptance_criteria"
          }
        ]
      }
    },
    {
      "target": "blender-recipe-decomposer",
      "type": "boundary_delegation",
      "label": "Deferred scope split into follow-up recipes",
      "when": {
        "all": [
          {
            "field": "fit.multiDeliverableDetected",
            "operator": "equals",
            "value": true
          }
        ]
      }
    },
    {
      "target": "pre-handoff-verification",
      "type": "progression",
      "label": "Delivery gate after scope and gates settle",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "final_verification"
          }
        ]
      }
    }
  ]
}
