{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "render-export-evidence",
  "version": "1.0.0",
  "category": "evidence-and-handoff",
  "role": "artifact-truth-and-provenance-auditor",
  "purpose": "Verify preview/render/GLB artifact truth by recording commands, inputs, output paths, file existence, validation notes, limitations, and conservative status labels.",
  "capabilityTier": "L0",
  "triggers": [
    "Did the render produce?",
    "Can I claim the GLB exists?",
    "Verify export evidence.",
    "What artifact status should this have?",
    "Summarize preview/render/GLB evidence."
  ],
  "exclusions": [
    {
      "condition": "the user only needs a scene plan with no runtime or artifact evidence",
      "delegateTo": "runtime-readiness",
      "reason": "Delegates out-of-scope requests to runtime-readiness"
    },
    {
      "condition": "runtime readiness or path selection has not been completed and the user wants setup or routing; use runtime-readiness or runtime-path-picker",
      "delegateTo": "runtime-readiness",
      "reason": "Delegates out-of-scope requests to runtime-readiness"
    },
    {
      "condition": "the task is gating a handoff via confirm-or-downgrade rules; use pre-handoff-verification",
      "delegateTo": "pre-handoff-verification",
      "reason": "Delegates out-of-scope requests to pre-handoff-verification"
    },
    {
      "condition": "the task is rendering the formatted preview/eval report Markdown; use preview-report",
      "delegateTo": "preview-report",
      "reason": "Delegates out-of-scope requests to preview-report"
    },
    {
      "condition": "the task is GLB web integration after evidence is already classified and gated; use glb-web-handoff",
      "delegateTo": "glb-web-handoff",
      "reason": "Delegates out-of-scope requests to glb-web-handoff"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "candidate_artifact_records",
        "type": "array",
        "description": "Reported file paths, byte sizes, SHA-256 digests, and inspection outputs for renders or GLBs"
      },
      {
        "name": "runtime_execution_trace",
        "type": "object",
        "description": "Factual runtime attempt record indicating whether Blender actually ran"
      }
    ],
    "optional": [
      {
        "name": "glb_inspector_or_validator_report",
        "type": "object",
        "description": "Optional output from scripts/inspect-glb.mjs or Khronos gltf-validator"
      }
    ]
  },
  "outputs": {
    "primary": [
      "artifact_truth_state_ledger",
      "downgrade_only_evidence_classification",
      "missing_evidence_remediation_checklist"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "runtime-readiness",
      "type": "upstream_reference",
      "label": "Runtime readiness",
      "when": {
        "all": [
          {
            "field": "runtime.path",
            "operator": "not_equals",
            "value": "unselected"
          },
          {
            "field": "runtime.verifiedReady",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "runtime-attempt-report",
      "type": "upstream_reference",
      "label": "Runtime attempt recording",
      "when": {
        "all": [
          {
            "field": "runtime.status",
            "operator": "in",
            "value": [
              "Attempted",
              "Produced",
              "Verified",
              "Failed"
            ]
          },
          {
            "field": "request.topic",
            "operator": "equals",
            "value": "attempt_report"
          }
        ]
      }
    },
    {
      "target": "scene-readiness",
      "type": "upstream_reference",
      "label": "Scene validation",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "holistic"
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "quality_validation"
          }
        ]
      }
    },
    {
      "target": "pre-handoff-verification",
      "type": "progression",
      "label": "Handoff gating (confirm-or-downgrade)",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "final_verification"
          }
        ]
      }
    },
    {
      "target": "preview-report",
      "type": "progression",
      "label": "Report Markdown rendering",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "report_formatting"
          },
          {
            "field": "handoff.consumerStack",
            "operator": "equals",
            "value": "stakeholder_report"
          }
        ]
      }
    },
    {
      "target": "glb-web-handoff",
      "type": "progression",
      "label": "GLB/web handoff",
      "when": {
        "all": [
          {
            "field": "artifact.type",
            "operator": "equals",
            "value": "glb"
          },
          {
            "field": "handoff.consumerStack",
            "operator": "equals",
            "value": "web_glb"
          }
        ]
      }
    },
    {
      "target": "plain-language-response",
      "type": "progression",
      "label": "User-facing explanation",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "final_communication"
          }
        ]
      }
    }
  ]
}
