{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "blender-lighting-material-planner",
  "version": "1.0.0",
  "category": "scene-planners",
  "role": "lighting-rig-and-lookdev-deep-planner",
  "purpose": "Build detailed lighting and material direction with portability and caveat handling for Blender/web-3D outputs.",
  "capabilityTier": "L0",
  "triggers": [
    "plan lighting and materials",
    "design cyberpunk lookdev",
    "define PBR and reflection strategy"
  ],
  "exclusions": [
    {
      "condition": "to claim final rendered quality or executed results",
      "delegateTo": "blender-composition-camera-planner",
      "reason": "Delegates out-of-scope requests to blender-composition-camera-planner"
    },
    {
      "condition": "to skip composition/camera context from blender-composition-camera-planner",
      "delegateTo": "blender-composition-camera-planner",
      "reason": "Delegates out-of-scope requests to blender-composition-camera-planner"
    },
    {
      "condition": "to validate existing lighting or materials",
      "delegateTo": "lighting-quality-checker",
      "reason": "use lighting-quality-checker and material-quality-checker"
    },
    {
      "condition": "to decide render engines (cycles-vs-eevee-decision), color management (color-management-decision), or file formats (output-format-decision)",
      "delegateTo": "color-management-decision",
      "reason": "output-format-decision"
    },
    {
      "condition": "to execute Blender or generate Python scripts",
      "delegateTo": "color-management-decision",
      "reason": "Delegates out-of-scope requests to color-management-decision"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "domain_scene_plan",
        "type": "object",
        "description": "Upstream scene layout and subject surface description"
      },
      {
        "name": "camera_framing_plan",
        "type": "object",
        "description": "Locked camera angles and hero silhouette requirements from blender-composition-camera-planner"
      }
    ],
    "optional": [
      {
        "name": "target_render_engine_hint",
        "type": "string",
        "description": "Preferred engine (Cycles, Eevee, or WebGL/GLB PBR export target)"
      }
    ]
  },
  "outputs": {
    "primary": [
      "key_fill_rim_lighting_plan",
      "pbr_material_and_roughness_spec",
      "hdri_and_reflection_strategy"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "blender-composition-camera-planner",
      "type": "upstream_reference",
      "label": "Upstream input from (blender-composition-camera-planner)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "camera_planning"
          }
        ]
      }
    },
    {
      "target": "color-management-decision",
      "type": "progression",
      "label": "Upstream input from (color-management-decision)",
      "when": {
        "all": [
          {
            "field": "decision.colorLocked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "cycles-vs-eevee-decision",
      "type": "progression",
      "label": "Upstream input from (cycles-vs-eevee-decision)",
      "when": {
        "all": [
          {
            "field": "decision.engineLocked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "output-format-decision",
      "type": "progression",
      "label": "Upstream input from (output-format-decision)",
      "when": {
        "all": [
          {
            "field": "decision.formatLocked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "lighting-quality-checker",
      "type": "progression",
      "label": "Next validation (lighting-quality-checker)",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "lighting"
          },
          {
            "field": "quality.verdict",
            "operator": "equals",
            "value": "not_run"
          }
        ]
      }
    },
    {
      "target": "material-quality-checker",
      "type": "progression",
      "label": "Next validation (material-quality-checker)",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "material"
          },
          {
            "field": "quality.verdict",
            "operator": "equals",
            "value": "not_run"
          }
        ]
      }
    },
    {
      "target": "blender-scene-quality-checker",
      "type": "progression",
      "label": "Then scene check",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "holistic"
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "quality_validation"
          }
        ]
      }
    },
    {
      "target": "glb-web-handoff",
      "type": "progression",
      "label": "Then delivery",
      "when": {
        "all": [
          {
            "field": "artifact.type",
            "operator": "equals",
            "value": "glb"
          },
          {
            "field": "handoff.consumerStack",
            "operator": "equals",
            "value": "web_glb"
          }
        ]
      }
    }
  ]
}
