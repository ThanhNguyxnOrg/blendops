{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "output-format-decision",
  "version": "1.0.0",
  "category": "render-and-output-decisions",
  "role": "still-animation-and-3d-format-selector",
  "purpose": "Pick the right output file format (PNG / JPG / WebP / OpenEXR / TIFF) per use case based on bit depth, compression, transparency, and consumer support.",
  "capabilityTier": "L0",
  "triggers": [
    "PNG or JPEG",
    "do we need EXR",
    "what format for the web"
  ],
  "exclusions": [
    {
      "condition": "raw modeling without rendering",
      "delegateTo": "cycles-vs-eevee-decision",
      "reason": "Delegates out-of-scope requests to cycles-vs-eevee-decision"
    },
    {
      "condition": "3D/GLB exports (out of scope — use glb-web-handoff, glb-mobile-performance-budget, or glb-animation-handoff)",
      "delegateTo": "glb-animation-handoff",
      "reason": "out of scope — use glb-web-handoff, glb-mobile-performance-budget, or glb-animation-handoff"
    },
    {
      "condition": "verifying saved files on disk after rendering",
      "delegateTo": "render-export-evidence",
      "reason": "use render-export-evidence"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "deliverable_channel_and_use",
        "type": "string",
        "description": "Downstream consumer surface (web hero image, compositing EXR pipeline, turntable video, interactive WebGL)"
      },
      {
        "name": "alpha_and_bit_depth_needs",
        "type": "object",
        "description": "Transparency (straight vs premultiplied alpha) and dynamic range (8-bit, 16-bit, 32-bit float) requirements"
      }
    ],
    "optional": [
      {
        "name": "file_size_ceiling",
        "type": "string",
        "description": "Optional delivery file size cap from glb-mobile-performance-budget or web spec"
      }
    ]
  },
  "outputs": {
    "primary": [
      "pinned_container_and_codec_spec",
      "bit_depth_and_alpha_mode_record",
      "color_space_and_export_verification_hooks"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "color-management-decision",
      "type": "upstream_reference",
      "label": "Color management",
      "when": {
        "all": [
          {
            "field": "decision.colorLocked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "resolution-aspect-decision",
      "type": "upstream_reference",
      "label": "Resolution & aspect ratio",
      "when": {
        "all": [
          {
            "field": "decision.aspectLocked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "cycles-vs-eevee-decision",
      "type": "upstream_reference",
      "label": "Engine choice",
      "when": {
        "all": [
          {
            "field": "decision.engineLocked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "render-export-evidence",
      "type": "progression",
      "label": "Render file verification",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "post_execution_audit"
          }
        ]
      }
    },
    {
      "target": "glb-animation-handoff",
      "type": "progression",
      "label": "3D / GLB exports (out of scope here) (glb-animation-handoff)",
      "when": {
        "all": [
          {
            "field": "artifact.hasAnimation",
            "operator": "equals",
            "value": true
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "animation_handoff"
          }
        ]
      }
    },
    {
      "target": "glb-mobile-performance-budget",
      "type": "boundary_delegation",
      "label": "3D / GLB exports (out of scope here) (glb-mobile-performance-budget)",
      "when": {
        "all": [
          {
            "field": "artifact.type",
            "operator": "equals",
            "value": "glb"
          },
          {
            "field": "budget.pinned",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "glb-web-handoff",
      "type": "progression",
      "label": "3D / GLB exports (out of scope here) (glb-web-handoff)",
      "when": {
        "all": [
          {
            "field": "artifact.type",
            "operator": "equals",
            "value": "glb"
          },
          {
            "field": "handoff.consumerStack",
            "operator": "equals",
            "value": "web_glb"
          }
        ]
      }
    }
  ]
}
