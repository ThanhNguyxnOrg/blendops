{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "scene-readiness",
  "version": "1.0.0",
  "category": "quality-validators",
  "role": "holistic-scene-readiness-aggregator",
  "purpose": "Apply multi-category readiness gates with pass/warn/fail and evidence-bound verdicts.",
  "capabilityTier": "L0",
  "triggers": [
    "quality-check this scene",
    "is this ready",
    "evaluate pass warn fail"
  ],
  "exclusions": [
    {
      "condition": "as a replacement for evidence collection",
      "delegateTo": "product-hero-scene-planner",
      "reason": "Delegates out-of-scope requests to product-hero-scene-planner"
    },
    {
      "condition": "to fabricate confidence in missing artifacts",
      "delegateTo": "lighting-material-plan",
      "reason": "Delegates out-of-scope requests to lighting-material-plan"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "scene_plan_and_specialist_verdicts",
        "type": "object",
        "description": "Scene specification plus specialist rows from material, lighting, composition, and polycount checkers"
      },
      {
        "name": "acceptance_criteria_table",
        "type": "object",
        "description": "Measurable Pass/Warn/Fail thresholds for the target deliverable"
      }
    ],
    "optional": [
      {
        "name": "preview_or_inspection_notes",
        "type": "object",
        "description": "Optional read-only scene inspection summary or viewport preview notes"
      }
    ]
  },
  "outputs": {
    "primary": [
      "holistic_scene_quality_verdict",
      "aggregated_pass_warn_fail_table",
      "blocking_defect_remediation_route"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "composition-quality-checker",
      "type": "upstream_reference",
      "label": "Focused domain validation (if gaps found) (composition-quality-checker)",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "composition"
          },
          {
            "field": "quality.verdict",
            "operator": "equals",
            "value": "not_run"
          }
        ]
      }
    },
    {
      "target": "lighting-quality-checker",
      "type": "upstream_reference",
      "label": "Focused domain validation (if gaps found) (lighting-quality-checker)",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "lighting"
          },
          {
            "field": "quality.verdict",
            "operator": "equals",
            "value": "not_run"
          }
        ]
      }
    },
    {
      "target": "material-quality-checker",
      "type": "upstream_reference",
      "label": "Focused domain validation (if gaps found) (material-quality-checker)",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "material"
          },
          {
            "field": "quality.verdict",
            "operator": "equals",
            "value": "not_run"
          }
        ]
      }
    },
    {
      "target": "polycount-budget-checker",
      "type": "upstream_reference",
      "label": "Focused domain validation (if gaps found) (polycount-budget-checker)",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "polycount"
          },
          {
            "field": "budget.verdict",
            "operator": "equals",
            "value": "Not Run"
          }
        ]
      }
    },
    {
      "target": "render-export-evidence",
      "type": "progression",
      "label": "Evidence classification",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "post_execution_audit"
          }
        ]
      }
    },
    {
      "target": "pre-handoff-verification",
      "type": "progression",
      "label": "Handoff gate",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "final_verification"
          }
        ]
      }
    },
    {
      "target": "glb-web-handoff",
      "type": "conditional",
      "label": "Web delivery (when applicable)",
      "when": {
        "all": [
          {
            "field": "artifact.type",
            "operator": "equals",
            "value": "glb"
          },
          {
            "field": "handoff.consumerStack",
            "operator": "equals",
            "value": "web_glb"
          }
        ]
      }
    },
    {
      "target": "plain-language-response",
      "type": "progression",
      "label": "Final communication",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "final_communication"
          }
        ]
      }
    }
  ]
}
