{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "using-blendops",
  "version": "2.0.0",
  "category": "routing-and-governance",
  "role": "entry-router-stage-router-and-plain-language-output",
  "purpose": "Entry point for BlendOps: pick the next stage from current artifacts and evidence, and keep every user-facing reply in plain language with honest truth states.",
  "capabilityTier": "L0",
  "routingPrecedence": {
    "group": "entry-and-stage-routing",
    "rank": 3,
    "activationGate": {
      "goalClarity": "clear",
      "recipeSelected": true,
      "preflightPassed": true,
      "hasStageOrArtifactInventory": true
    }
  },
  "triggers": [
    "where are we in the workflow",
    "what's next",
    "resume from here",
    "next skill",
    "What should I do next?",
    "Which BlendOps skill should I use?",
    "Is this ready?",
    "Can I run the runtime eval?",
    "How do I package/install BlendOps?",
    "What is blocked?",
    "write final user summary",
    "explain this for non-Blender user",
    "make this stakeholder-friendly"
  ],
  "exclusions": [
    {
      "condition": "Goal is clear but no recipe or pack has been chosen yet",
      "delegateTo": "scoping-3d-briefs",
      "reason": "Selects the fitting recipe/pack at precedence Rank 2"
    },
    {
      "condition": "Pack is selected and brief exists, but pack preflight has not completed yet",
      "delegateTo": "defining-done-and-gates",
      "reason": "Executes preflight readiness verification at precedence Rank 3 before stage routing"
    },
    {
      "condition": "Active MCP runtime bridge conflict on port 9876",
      "delegateTo": "setting-up-blender-runtime",
      "reason": "Resolves port and dual add-on conflicts before advancing"
    },
    {
      "condition": "The goal is clear and the user wants to select the right recipe or pack",
      "delegateTo": "scoping-3d-briefs",
      "reason": "Scores candidate recipes/packs and detects multi-deliverable scope"
    },
    {
      "condition": "A recipe or pack is already selected and needs preflight readiness verification",
      "delegateTo": "defining-done-and-gates",
      "reason": "Evaluates the preflight matrix across brief completeness, runtime posture, and asset readiness"
    },
    {
      "condition": "The user explicitly asks to turn an idea into a structured 3D brief",
      "delegateTo": "scoping-3d-briefs",
      "reason": "Locks the canonical 8-slot 3D brief before scene planning"
    },
    {
      "condition": "The user asks to plan a product-hero scene directly",
      "delegateTo": "planning-product-scenes",
      "reason": "Handles domain-specific scene planning once brief and recipe are known"
    },
    {
      "condition": "The user asks for render or export artifact verification",
      "delegateTo": "verifying-before-handoff",
      "reason": "Classifies artifact truth states from on-disk paths and validation notes"
    },
    {
      "condition": "The user asks for Blender MCP runtime preflight verification",
      "delegateTo": "setting-up-blender-runtime",
      "reason": "Verifies Path 1 or Path 2 runtime readiness without claiming execution"
    },
    {
      "condition": "to hide blockers, drop caveats for readability, or overclaim runtime or artifact success",
      "delegateTo": "verifying-before-handoff",
      "reason": "Delegates out-of-scope requests to verifying-before-handoff"
    },
    {
      "condition": "to upgrade Runtime or Artifact truth states",
      "delegateTo": "verifying-before-handoff",
      "reason": "Delegates out-of-scope requests to verifying-before-handoff"
    },
    {
      "condition": "to classify raw artifact evidence",
      "delegateTo": "verifying-before-handoff",
      "reason": "use verifying-before-handoff"
    },
    {
      "condition": "to generate technical pass/warn/fail checks",
      "delegateTo": "verifying-before-handoff",
      "reason": "use verifying-before-handoff or domain quality checkers"
    },
    {
      "condition": "to assemble technical GLB/web compatibility summaries",
      "delegateTo": "handing-off-glb-to-web",
      "reason": "use handing-off-glb-to-web"
    },
    {
      "condition": "to gate handoff readiness",
      "delegateTo": "verifying-before-handoff",
      "reason": "use verifying-before-handoff"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "current_artifact_inventory",
        "type": "artifact_inventory",
        "description": "Determines current milestone stage and downgrade-only truth labels"
      },
      {
        "name": "active_intent",
        "type": "string",
        "description": "Prevents routing to the wrong domain branch"
      }
    ],
    "optional": [
      {
        "name": "target_pack_or_recipe",
        "type": "string",
        "description": "Narrows milestone track"
      },
      {
        "name": "user_request",
        "type": "string",
        "description": "Ambiguous, mixed, or entry-level user question about BlendOps capabilities or next action"
      },
      {
        "name": "current_status_context",
        "type": "object",
        "description": "Optional context about known files, docs, or blockers"
      },
      {
        "name": "verified_workflow_and_evidence_state",
        "type": "object",
        "description": "Final pre-handoff verification gate status, runtime truth state, and artifact truth state"
      },
      {
        "name": "deliverable_summary_inputs",
        "type": "object",
        "description": "Technical outputs from scene planners, quality checkers, or handoff packagers to translate"
      },
      {
        "name": "stakeholder_audience_profile",
        "type": "string",
        "description": "Target reader role (product manager, web developer, creative director, end user)"
      }
    ]
  },
  "outputs": {
    "primary": [
      "current_stage_name",
      "single_immediate_next_skill",
      "preconditions_checklist",
      "recommended_next_action",
      "target_skill_or_doc",
      "why_this_is_safe",
      "plain_language_stakeholder_response",
      "explicit_runtime_and_artifact_status_block",
      "jargon_free_next_steps"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "defining-done-and-gates",
      "type": "upstream_reference",
      "label": "Pack entry preflight gate",
      "when": {
        "all": [
          {
            "field": "preflight.passed",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "setting-up-blender-runtime",
      "type": "conditional",
      "label": "Runtime readiness check",
      "when": {
        "all": [
          {
            "field": "runtime.status",
            "operator": "equals",
            "value": "Not Run"
          },
          {
            "field": "stage.requiresRuntime",
            "operator": "equals",
            "value": true
          }
        ]
      }
    },
    {
      "target": "setting-up-blender-runtime",
      "type": "fallback",
      "label": "Active MCP bridge conflict on port 9876",
      "when": {
        "all": [
          {
            "field": "runtime.conflictDetected",
            "operator": "equals",
            "value": true
          }
        ]
      }
    },
    {
      "target": "defining-done-and-gates",
      "type": "boundary_delegation",
      "label": "Mid-workflow scope expansion or unapproved deliverable addition",
      "when": {
        "all": [
          {
            "field": "scope.driftDetected",
            "operator": "equals",
            "value": true
          }
        ]
      }
    },
    {
      "target": "verifying-before-handoff",
      "type": "progression",
      "label": "Evidence updates for render or export outputs",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "post_execution_audit"
          }
        ]
      }
    },
    {
      "target": "verifying-before-handoff",
      "type": "fallback",
      "label": "Failed gate / blocked mode exit / final gate",
      "when": {
        "any": [
          {
            "field": "gate.status",
            "operator": "equals",
            "value": "failed"
          },
          {
            "field": "runtime.mode",
            "operator": "equals",
            "value": "blocked"
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "final_verification"
          }
        ]
      }
    },
    {
      "target": "scoping-3d-briefs",
      "type": "progression",
      "label": "Recipe or pack selection when goal becomes clear",
      "when": {
        "all": [
          {
            "field": "goal.clarity",
            "operator": "equals",
            "value": "clear"
          },
          {
            "field": "recipe.selected",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "defining-done-and-gates",
      "type": "conditional",
      "label": "Pack preflight readiness check when recipe is already chosen",
      "when": {
        "all": [
          {
            "field": "recipe.selected",
            "operator": "equals",
            "value": true
          },
          {
            "field": "preflight.passed",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "scoping-3d-briefs",
      "type": "progression",
      "label": "Initial 3D brief creation",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "setting-up-blender-runtime",
      "type": "conditional",
      "label": "Runtime path selection",
      "when": {
        "all": [
          {
            "field": "request.topic",
            "operator": "equals",
            "value": "runtime_selection"
          }
        ]
      }
    },
    {
      "target": "setting-up-blender-runtime",
      "type": "conditional",
      "label": "Official runtime setup",
      "when": {
        "all": [
          {
            "field": "request.topic",
            "operator": "equals",
            "value": "runtime_setup"
          }
        ]
      }
    },
    {
      "target": "setting-up-blender-runtime",
      "type": "conditional",
      "label": "Runtime readiness preflight",
      "when": {
        "all": [
          {
            "field": "request.topic",
            "operator": "equals",
            "value": "runtime_readiness"
          }
        ]
      }
    },
    {
      "target": "planning-product-scenes",
      "type": "alternative",
      "label": "Scene planning",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.id",
            "operator": "equals",
            "value": "product-hero-v0"
          }
        ]
      }
    },
    {
      "target": "verifying-before-handoff",
      "type": "conditional",
      "label": "Render/export evidence",
      "when": {
        "all": [
          {
            "field": "request.topic",
            "operator": "equals",
            "value": "artifact_evidence"
          }
        ]
      }
    },
    {
      "target": "verifying-before-handoff",
      "type": "fallback",
      "label": "Failed workflow gate / pre-handoff check",
      "when": {
        "all": [
          {
            "field": "gate.status",
            "operator": "equals",
            "value": "failed"
          }
        ]
      }
    },
    {
      "target": "handing-off-glb-to-web",
      "type": "conditional",
      "label": "GLB handoff",
      "when": {
        "all": [
          {
            "field": "request.topic",
            "operator": "equals",
            "value": "glb_handoff"
          }
        ]
      }
    },
    {
      "target": "verifying-before-handoff",
      "type": "fallback",
      "label": "Upstream quality pass/warn/fail validation (verifying-before-handoff)",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "holistic"
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "quality_validation"
          }
        ]
      }
    },
    {
      "target": "planning-camera-and-framing",
      "type": "fallback",
      "label": "Upstream quality pass/warn/fail validation (planning-camera-and-framing)",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "composition"
          },
          {
            "field": "quality.verdict",
            "operator": "equals",
            "value": "not_run"
          }
        ]
      }
    },
    {
      "target": "planning-lighting-and-materials",
      "type": "fallback",
      "label": "Upstream quality pass/warn/fail validation (planning-lighting-and-materials)",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "lighting"
          },
          {
            "field": "quality.verdict",
            "operator": "equals",
            "value": "not_run"
          }
        ]
      }
    },
    {
      "target": "planning-lighting-and-materials",
      "type": "fallback",
      "label": "Upstream quality pass/warn/fail validation (planning-lighting-and-materials)",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "material"
          },
          {
            "field": "quality.verdict",
            "operator": "equals",
            "value": "not_run"
          }
        ]
      }
    },
    {
      "target": "budgeting-glb-for-web",
      "type": "fallback",
      "label": "Upstream quality pass/warn/fail validation (budgeting-glb-for-web)",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "polycount"
          },
          {
            "field": "budget.verdict",
            "operator": "equals",
            "value": "Not Run"
          }
        ]
      }
    },
    {
      "target": "handing-off-glb-to-web",
      "type": "upstream_reference",
      "label": "Upstream GLB/web handoff summary",
      "when": {
        "all": [
          {
            "field": "artifact.type",
            "operator": "equals",
            "value": "glb"
          },
          {
            "field": "handoff.consumerStack",
            "operator": "equals",
            "value": "web_glb"
          }
        ]
      }
    },
    {
      "target": "verifying-before-handoff",
      "type": "upstream_reference",
      "label": "Upstream handoff gate check",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "final_verification"
          }
        ]
      }
    },
    {
      "target": "setting-up-blender-runtime",
      "type": "upstream_reference",
      "label": "Runtime readiness check when runtime is unverified",
      "when": {
        "all": [
          {
            "field": "runtime.path",
            "operator": "not_equals",
            "value": "unselected"
          },
          {
            "field": "runtime.verifiedReady",
            "operator": "equals",
            "value": false
          }
        ]
      }
    }
  ]
}
