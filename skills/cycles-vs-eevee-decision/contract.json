{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "cycles-vs-eevee-decision",
  "version": "1.0.0",
  "category": "render-and-output-decisions",
  "role": "render-engine-tradeoff-selector",
  "purpose": "Pick Cycles, Eevee, or Workbench for a render based on quality bar, time budget, and feature requirements (caustics, subsurface, etc.). Note: Eevee was named Eevee Next on Blender 4.2-4.x only.",
  "capabilityTier": "L0",
  "triggers": [
    "Cycles or Eevee",
    "what render engine",
    "is Eevee enough",
    "render is too slow"
  ],
  "exclusions": [
    {
      "condition": "for a known repeat render (engine already chosen)",
      "delegateTo": "lighting-material-plan",
      "reason": "engine already chosen"
    },
    {
      "condition": "for non-render work (modeling / animation prep)",
      "delegateTo": "output-format-decision",
      "reason": "modeling / animation prep"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "deliverable_use_case",
        "type": "string",
        "description": "Whether the output is a final hero still, lookdev preview, animation turntable, or baked GLB source"
      },
      {
        "name": "optical_feature_requirements",
        "type": "array",
        "description": "Required optical features (refraction, caustics, Volumetrics, SSS, soft area shadows)"
      },
      {
        "name": "render_time_and_hardware_budget",
        "type": "string",
        "description": "Per-frame render time ceiling and available GPU/CPU compute posture"
      }
    ],
    "optional": [
      {
        "name": "blender_version_token",
        "type": "string",
        "description": "Target Blender version governing BLENDER_EEVEE vs BLENDER_EEVEE_NEXT naming"
      }
    ]
  },
  "outputs": {
    "primary": [
      "selected_render_engine_record",
      "sample_and_denoiser_targets",
      "engine_tradeoff_and_fallback_caveats"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "lighting-material-plan",
      "type": "upstream_reference",
      "label": "Lighting and material setup aligned with engine choice",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "lookdev_planning"
          }
        ]
      }
    },
    {
      "target": "color-management-decision",
      "type": "upstream_reference",
      "label": "Color configuration decision",
      "when": {
        "all": [
          {
            "field": "decision.colorLocked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "output-format-decision",
      "type": "progression",
      "label": "Output container / codec decision",
      "when": {
        "all": [
          {
            "field": "decision.formatLocked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "resolution-aspect-decision",
      "type": "upstream_reference",
      "label": "Render resolution and aspect ratio decision",
      "when": {
        "all": [
          {
            "field": "decision.aspectLocked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "render-export-evidence",
      "type": "progression",
      "label": "Post-render output verification",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "post_execution_audit"
          }
        ]
      }
    }
  ]
}
