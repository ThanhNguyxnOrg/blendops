{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "r3f-component-plan",
  "version": "1.0.0",
  "category": "evidence-and-handoff",
  "role": "r3f-component-contract-architect",
  "purpose": "Plan the React Three Fiber component shape (props, refs, Suspense, useGLTF cache, animation hooks) before delivering a GLB to a web team.",
  "capabilityTier": "L0",
  "triggers": [
    "how should the React component look",
    "what props should I expose",
    "ref shape for the model",
    "we use react-three-fiber"
  ],
  "exclusions": [
    {
      "condition": "consumers using vanilla Three.js (different API)",
      "delegateTo": "glb-web-handoff",
      "reason": "different API"
    },
    {
      "condition": "consumers using Babylon / model-viewer (different stack)",
      "delegateTo": "glb-animation-handoff",
      "reason": "different stack"
    },
    {
      "condition": "the GLB is rendered server-side (e.g. AR pre-render); no React component needed",
      "delegateTo": "plain-language-response",
      "reason": "Delegates out-of-scope requests to plain-language-response"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "glb_delivery_contract",
        "type": "object",
        "description": "Locked GLB node hierarchy, material slots, and compression spec from glb-web-handoff"
      },
      {
        "name": "r3f_version_and_use_case",
        "type": "object",
        "description": "Target @react-three/fiber major version (8 vs 9) and interactive component use case"
      }
    ],
    "optional": [
      {
        "name": "animation_clip_contract",
        "type": "object",
        "description": "Optional clip names, triggers, and crossfade rules from glb-animation-handoff"
      }
    ]
  },
  "outputs": {
    "primary": [
      "r3f_component_props_and_ref_spec",
      "suspense_caching_and_dispose_contract",
      "consumer_call_site_usage_outline"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "glb-animation-handoff",
      "type": "upstream_reference",
      "label": "Animation contract",
      "when": {
        "all": [
          {
            "field": "artifact.hasAnimation",
            "operator": "equals",
            "value": true
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "animation_handoff"
          }
        ]
      }
    },
    {
      "target": "mobile-glb-budget",
      "type": "upstream_reference",
      "label": "Performance budget ceilings",
      "when": {
        "all": [
          {
            "field": "artifact.type",
            "operator": "equals",
            "value": "glb"
          },
          {
            "field": "budget.pinned",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "color-management-decision",
      "type": "upstream_reference",
      "label": "Color and material checks (color-management-decision)",
      "when": {
        "all": [
          {
            "field": "decision.colorLocked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "material-quality-checker",
      "type": "upstream_reference",
      "label": "Color and material checks (material-quality-checker)",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "material"
          },
          {
            "field": "quality.verdict",
            "operator": "equals",
            "value": "not_run"
          }
        ]
      }
    },
    {
      "target": "glb-web-handoff",
      "type": "upstream_reference",
      "label": "Web delivery packaging",
      "when": {
        "all": [
          {
            "field": "artifact.type",
            "operator": "equals",
            "value": "glb"
          },
          {
            "field": "handoff.consumerStack",
            "operator": "equals",
            "value": "web_glb"
          }
        ]
      }
    },
    {
      "target": "plain-language-response",
      "type": "progression",
      "label": "Final user-facing response",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "final_communication"
          }
        ]
      }
    }
  ]
}
