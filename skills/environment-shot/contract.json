{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "environment-shot",
  "version": "1.0.0",
  "category": "scene-planners",
  "role": "environment-establishing-shot-architect",
  "purpose": "Plan a wide environment / establishing-shot scene (locale, time of day, weather, focal subject, depth, atmosphere) before any modeling or render attempt.",
  "capabilityTier": "L0",
  "triggers": [
    "establishing shot of",
    "wide shot of",
    "city / forest / desert / ocean scene",
    "set the scene"
  ],
  "exclusions": [
    {
      "condition": "character portrait",
      "delegateTo": "character-portrait",
      "reason": "use character-portrait"
    },
    {
      "condition": "product hero",
      "delegateTo": "product-hero-scene-planner",
      "reason": "use product-hero-scene-planner"
    },
    {
      "condition": "interior arch viz with focus on furniture / surfaces",
      "delegateTo": "interior-scene",
      "reason": "use interior-scene"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "locked_3d_brief",
        "type": "object",
        "description": "Locked 3D brief specifying locale, mood, focal anchor, and delivery channel"
      },
      {
        "name": "atmosphere_and_time_of_day",
        "type": "object",
        "description": "Target time of day, weather condition, and atmospheric haze/fog parameters"
      }
    ],
    "optional": [
      {
        "name": "asset_discovery_constraints",
        "type": "object",
        "description": "Available environment kitbash or terrain assets from asset-discovery"
      }
    ]
  },
  "outputs": {
    "primary": [
      "foreground_midground_background_layer_plan",
      "sun_sky_atmosphere_specification",
      "horizon_and_scale_anchor_plan"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "intent-to-3d-brief-writer",
      "type": "upstream_reference",
      "label": "Brief writer",
      "when": {
        "all": [
          {
            "field": "goal.clarity",
            "operator": "equals",
            "value": "clear"
          },
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "asset-discovery",
      "type": "upstream_reference",
      "label": "Asset discovery",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "assets.discoveryComplete",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "composition-quality-checker",
      "type": "progression",
      "label": "Composition validation",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "composition"
          },
          {
            "field": "quality.verdict",
            "operator": "equals",
            "value": "not_run"
          }
        ]
      }
    },
    {
      "target": "lighting-quality-checker",
      "type": "progression",
      "label": "Lighting validation",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "lighting"
          },
          {
            "field": "quality.verdict",
            "operator": "equals",
            "value": "not_run"
          }
        ]
      }
    },
    {
      "target": "scene-readiness",
      "type": "progression",
      "label": "Quality readiness",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "holistic"
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "quality_validation"
          }
        ]
      }
    }
  ]
}
