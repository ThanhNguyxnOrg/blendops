{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "blendops-camera",
  "version": "2.0.0",
  "category": "scene-planners",
  "role": "camera-composition-framing-and-aspect-planner",
  "purpose": "Plan camera, composition, resolution, and aspect ratio, and check framing quality against written criteria.",
  "capabilityTier": "L0",
  "triggers": [
    "improve composition and camera",
    "choose hero framing",
    "set camera strategy for product hero",
    "is the framing okay",
    "check composition",
    "subject feels off-center",
    "too much negative space",
    "what resolution",
    "how big should the render be",
    "16:9 or square"
  ],
  "exclusions": [
    {
      "condition": "to design lighting rigs or surface materials/lookdev",
      "delegateTo": "blendops-lighting-materials",
      "reason": "use blendops-lighting-materials"
    },
    {
      "condition": "to choose delivery file formats",
      "delegateTo": "blendops-render-settings",
      "reason": "use blendops-render-settings"
    },
    {
      "condition": "when subject intent is undefined",
      "delegateTo": "blendops-product-shot",
      "reason": "Delegates out-of-scope requests to blendops-product-shot"
    },
    {
      "condition": "material validation",
      "delegateTo": "blendops-lighting-materials",
      "reason": "use blendops-lighting-materials"
    },
    {
      "condition": "lighting validation",
      "delegateTo": "blendops-lighting-materials",
      "reason": "use blendops-lighting-materials"
    },
    {
      "condition": "broad scene Pass/Warn/Fail readiness review",
      "delegateTo": "blendops-final-check",
      "reason": "use blendops-final-check"
    },
    {
      "condition": "classifying render or export artifact evidence",
      "delegateTo": "blendops-final-check",
      "reason": "use blendops-final-check"
    },
    {
      "condition": "pure modeling",
      "delegateTo": "blendops-render-settings",
      "reason": "Delegates out-of-scope requests to blendops-render-settings"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "domain_scene_plan",
        "type": "object",
        "description": "Upstream scene layout plan defining subject scale, staging, and depth layers"
      },
      {
        "name": "framing_goal",
        "type": "string",
        "description": "Target shot type (hero three-quarter, orthographic catalog grid, portrait, wide establishing)"
      }
    ],
    "optional": [
      {
        "name": "pinned_aspect_ratio",
        "type": "string",
        "description": "Aspect ratio lock from blendops-camera"
      },
      {
        "name": "camera_and_framing_spec",
        "type": "object",
        "description": "Camera focal length, sensor, angle, and subject placement from blendops-camera"
      },
      {
        "name": "pinned_aspect_ratio_and_subject",
        "type": "object",
        "description": "Locked aspect ratio and primary/secondary focal hierarchy from brief"
      },
      {
        "name": "viewport_or_render_preview_notes",
        "type": "string",
        "description": "Optional framing observations from a viewport or preview capture"
      },
      {
        "name": "target_delivery_surfaces",
        "type": "array",
        "description": "Target display placements (desktop hero banner, mobile portrait feed, 1:1 e-commerce card, 4K print)"
      },
      {
        "name": "framing_and_crop_strategy",
        "type": "string",
        "description": "Whether deliverables use a single master aspect ratio with safe-zone crops or separate camera setups"
      },
      {
        "name": "render_time_constraints",
        "type": "string",
        "description": "Optional render time ceiling influencing pixel dimensions and percentage scale"
      }
    ]
  },
  "outputs": {
    "primary": [
      "camera_rig_specification",
      "focal_length_and_dof_plan",
      "composition_anchor_guidelines",
      "composition_verdict_table",
      "silhouette_and_headroom_assessment",
      "camera_replan_remediation_hints",
      "pinned_pixel_dimensions_and_aspect_ratio",
      "safe_frame_and_overscan_margins",
      "camera_sensor_fit_alignment_notes"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "blendops-product-shot",
      "type": "upstream_reference",
      "label": "Upstream input from",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "product_hero"
          }
        ]
      }
    },
    {
      "target": "blendops-render-settings",
      "type": "conditional",
      "label": "Lateral output specs (if needed) (blendops-render-settings)",
      "when": {
        "all": [
          {
            "field": "decision.formatLocked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "blendops-lighting-materials",
      "type": "progression",
      "label": "Next (lookdev & lighting)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "lookdev_planning"
          }
        ]
      }
    },
    {
      "target": "blendops-final-check",
      "type": "progression",
      "label": "Then (validation) (blendops-final-check)",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "holistic"
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "quality_validation"
          }
        ]
      }
    },
    {
      "target": "blendops-final-check",
      "type": "progression",
      "label": "Artifact evidence classification",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "post_execution_audit"
          }
        ]
      }
    },
    {
      "target": "blendops-lighting-materials",
      "type": "upstream_reference",
      "label": "Material validation",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "material"
          },
          {
            "field": "quality.verdict",
            "operator": "equals",
            "value": "not_run"
          }
        ]
      }
    },
    {
      "target": "blendops-lighting-materials",
      "type": "upstream_reference",
      "label": "Lighting validation",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "lighting"
          },
          {
            "field": "quality.verdict",
            "operator": "equals",
            "value": "not_run"
          }
        ]
      }
    },
    {
      "target": "blendops-lighting-materials",
      "type": "upstream_reference",
      "label": "Color configuration decision",
      "when": {
        "all": [
          {
            "field": "decision.colorLocked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "blendops-render-settings",
      "type": "progression",
      "label": "Render engine decision",
      "when": {
        "all": [
          {
            "field": "decision.engineLocked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    }
  ]
}
