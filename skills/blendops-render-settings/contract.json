{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "blendops-render-settings",
  "version": "2.0.0",
  "category": "render-and-output-decisions",
  "role": "render-engine-and-output-format-decision",
  "purpose": "Choose Cycles or EEVEE and the output format for stills, sequences, video, or GLB based on the delivery target.",
  "capabilityTier": "L0",
  "triggers": [
    "Cycles or Eevee",
    "what render engine",
    "is Eevee enough",
    "render is too slow",
    "PNG or JPEG",
    "do we need EXR",
    "what format for the web"
  ],
  "exclusions": [
    {
      "condition": "for a known repeat render (engine already chosen)",
      "delegateTo": "blendops-lighting-materials",
      "reason": "engine already chosen"
    },
    {
      "condition": "3D/GLB exports (out of scope — use blendops-glb-web-handoff, blendops-glb-budget, or blendops-glb-web-handoff)",
      "delegateTo": "blendops-glb-web-handoff",
      "reason": "out of scope — use blendops-glb-web-handoff, blendops-glb-budget, or blendops-glb-web-handoff"
    },
    {
      "condition": "verifying saved files on disk after rendering",
      "delegateTo": "blendops-final-check",
      "reason": "use blendops-final-check"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "deliverable_use_case",
        "type": "string",
        "description": "Whether the output is a final hero still, lookdev preview, animation turntable, or baked GLB source"
      },
      {
        "name": "optical_feature_requirements",
        "type": "array",
        "description": "Required optical features (refraction, caustics, Volumetrics, SSS, soft area shadows)"
      },
      {
        "name": "render_time_and_hardware_budget",
        "type": "string",
        "description": "Per-frame render time ceiling and available GPU/CPU compute posture"
      }
    ],
    "optional": [
      {
        "name": "blender_version_token",
        "type": "string",
        "description": "Target Blender version governing BLENDER_EEVEE vs BLENDER_EEVEE_NEXT naming"
      },
      {
        "name": "deliverable_channel_and_use",
        "type": "string",
        "description": "Downstream consumer surface (web hero image, compositing EXR pipeline, turntable video, interactive WebGL)"
      },
      {
        "name": "alpha_and_bit_depth_needs",
        "type": "object",
        "description": "Transparency (straight vs premultiplied alpha) and dynamic range (8-bit, 16-bit, 32-bit float) requirements"
      },
      {
        "name": "file_size_ceiling",
        "type": "string",
        "description": "Optional delivery file size cap from blendops-glb-budget or web spec"
      }
    ]
  },
  "outputs": {
    "primary": [
      "selected_render_engine_record",
      "sample_and_denoiser_targets",
      "engine_tradeoff_and_fallback_caveats",
      "pinned_container_and_codec_spec",
      "bit_depth_and_alpha_mode_record",
      "color_space_and_export_verification_hooks"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "blendops-lighting-materials",
      "type": "upstream_reference",
      "label": "Lighting and material setup aligned with engine choice",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "lookdev_planning"
          }
        ]
      }
    },
    {
      "target": "blendops-lighting-materials",
      "type": "upstream_reference",
      "label": "Color configuration decision",
      "when": {
        "all": [
          {
            "field": "decision.colorLocked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "blendops-camera",
      "type": "upstream_reference",
      "label": "Render resolution and aspect ratio decision",
      "when": {
        "all": [
          {
            "field": "decision.aspectLocked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "blendops-final-check",
      "type": "progression",
      "label": "Post-render output verification",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "post_execution_audit"
          }
        ]
      }
    },
    {
      "target": "blendops-glb-web-handoff",
      "type": "progression",
      "label": "3D / GLB exports (out of scope here) (blendops-glb-web-handoff)",
      "when": {
        "all": [
          {
            "field": "artifact.hasAnimation",
            "operator": "equals",
            "value": true
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "animation_handoff"
          }
        ]
      }
    },
    {
      "target": "blendops-glb-budget",
      "type": "boundary_delegation",
      "label": "3D / GLB exports (out of scope here) (blendops-glb-budget)",
      "when": {
        "all": [
          {
            "field": "artifact.type",
            "operator": "equals",
            "value": "glb"
          },
          {
            "field": "budget.pinned",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "blendops-glb-web-handoff",
      "type": "progression",
      "label": "3D / GLB exports (out of scope here) (blendops-glb-web-handoff)",
      "when": {
        "all": [
          {
            "field": "artifact.type",
            "operator": "equals",
            "value": "glb"
          },
          {
            "field": "handoff.consumerStack",
            "operator": "equals",
            "value": "web_glb"
          }
        ]
      }
    }
  ]
}
