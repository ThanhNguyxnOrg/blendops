{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "character-portrait",
  "version": "1.0.0",
  "category": "scene-planners",
  "role": "character-portrait-and-turntable-architect",
  "purpose": "Plan a character-portrait scene (subject, pose, expression, wardrobe, framing, lighting, background) before any modeling or render attempt.",
  "capabilityTier": "L0",
  "triggers": [
    "portrait of",
    "character looking at the camera",
    "headshot",
    "hero shot of [person / mascot / creature]"
  ],
  "exclusions": [
    {
      "condition": "product hero scenes",
      "delegateTo": "product-hero-scene-planner",
      "reason": "use product-hero-scene-planner"
    },
    {
      "condition": "environment establishing shots",
      "delegateTo": "environment-shot",
      "reason": "use environment-shot"
    },
    {
      "condition": "interior arch viz",
      "delegateTo": "interior-scene",
      "reason": "use interior-scene"
    },
    {
      "condition": "multi-character ensemble (this skill is single-subject)",
      "delegateTo": "intent-to-3d-brief-writer",
      "reason": "this skill is single-subject"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "locked_3d_brief",
        "type": "object",
        "description": "Locked 3D brief specifying character subject, expression/pose, and framing intent"
      },
      {
        "name": "character_asset_posture",
        "type": "object",
        "description": "Available character model/rig status and material readiness from asset discovery"
      }
    ],
    "optional": [
      {
        "name": "turntable_or_still_preference",
        "type": "string",
        "description": "Whether the deliverable is a portrait still, bust turntable, or full-body pose"
      }
    ]
  },
  "outputs": {
    "primary": [
      "character_staging_and_pose_plan",
      "eyeline_and_portrait_camera_anchors",
      "skin_hair_rim_lighting_hooks"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "intent-to-3d-brief-writer",
      "type": "upstream_reference",
      "label": "Upstream brief",
      "when": {
        "all": [
          {
            "field": "goal.clarity",
            "operator": "equals",
            "value": "clear"
          },
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "camera-composition",
      "type": "progression",
      "label": "Framing deep-dive",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "camera_planning"
          }
        ]
      }
    },
    {
      "target": "lighting-material-plan",
      "type": "progression",
      "label": "Lookdev deep-dive",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "lookdev_planning"
          }
        ]
      }
    },
    {
      "target": "asset-discovery",
      "type": "upstream_reference",
      "label": "Asset discovery",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "assets.discoveryComplete",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "composition-quality-checker",
      "type": "progression",
      "label": "Composition validation",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "composition"
          },
          {
            "field": "quality.verdict",
            "operator": "equals",
            "value": "not_run"
          }
        ]
      }
    },
    {
      "target": "lighting-quality-checker",
      "type": "progression",
      "label": "Lighting validation",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "lighting"
          },
          {
            "field": "quality.verdict",
            "operator": "equals",
            "value": "not_run"
          }
        ]
      }
    },
    {
      "target": "scene-readiness",
      "type": "progression",
      "label": "Scene quality validation",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "holistic"
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "quality_validation"
          }
        ]
      }
    }
  ]
}
