{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "done-criteria",
  "version": "1.0.0",
  "category": "process-discipline",
  "role": "done-condition-and-iteration-cap-pinner",
  "purpose": "Define explicit \"done\" conditions for a Blender recipe before starting work, so the agent stops at the right point instead of drifting into endless polish.",
  "capabilityTier": "L0",
  "triggers": [
    "when are we done",
    "let's set the bar",
    "what does done look like"
  ],
  "exclusions": [
    {
      "condition": "pure exploration or brainstorming",
      "delegateTo": "blender-brainstorming",
      "reason": "use blender-brainstorming; goal is divergence"
    },
    {
      "condition": "tiny single-shot requests",
      "delegateTo": "intent-to-3d-brief-writer",
      "reason": "Delegates out-of-scope requests to intent-to-3d-brief-writer"
    },
    {
      "condition": "splitting a broad multi-recipe request beforehand",
      "delegateTo": "blender-recipe-decomposer",
      "reason": "use blender-recipe-decomposer first"
    },
    {
      "condition": "authoring measurable acceptance rows from scratch",
      "delegateTo": "acceptance-criteria-builder",
      "reason": "use acceptance-criteria-builder first"
    },
    {
      "condition": "enforcing per-stage checklist gates during execution",
      "delegateTo": "stage-gates",
      "reason": "use stage-gates"
    },
    {
      "condition": "after work has already started and scope is drifting mid-flight",
      "delegateTo": "scope-guard",
      "reason": "use scope-guard"
    },
    {
      "condition": "performing the final verification gate before delivery",
      "delegateTo": "pre-handoff-verification",
      "reason": "use pre-handoff-verification"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "locked_3d_brief",
        "type": "object",
        "description": "Locked 8-slot 3D brief defining deliverable intent"
      },
      {
        "name": "acceptance_criteria_rows",
        "type": "array",
        "description": "Measurable Pass/Warn/Fail criteria from acceptance-criteria-builder"
      }
    ],
    "optional": [
      {
        "name": "iteration_budget_preference",
        "type": "integer",
        "description": "Maximum refinement passes before halting or escalating"
      }
    ]
  },
  "outputs": {
    "primary": [
      "definition_of_done_checklist",
      "max_iteration_caps_per_stage",
      "halt_and_escalation_triggers"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "intent-to-3d-brief-writer",
      "type": "upstream_reference",
      "label": "Intent brief",
      "when": {
        "all": [
          {
            "field": "goal.clarity",
            "operator": "equals",
            "value": "clear"
          },
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "blender-recipe-decomposer",
      "type": "boundary_delegation",
      "label": "Scope splitting beforehand",
      "when": {
        "all": [
          {
            "field": "fit.multiDeliverableDetected",
            "operator": "equals",
            "value": true
          }
        ]
      }
    },
    {
      "target": "acceptance-criteria-builder",
      "type": "upstream_reference",
      "label": "Measurable acceptance rows",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "acceptance_criteria"
          }
        ]
      }
    },
    {
      "target": "stage-gates",
      "type": "progression",
      "label": "Per-stage workflow gates",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "stage_gates"
          }
        ]
      }
    },
    {
      "target": "scope-guard",
      "type": "progression",
      "label": "Mid-flight scope drift",
      "when": {
        "all": [
          {
            "field": "scope.driftDetected",
            "operator": "equals",
            "value": true
          }
        ]
      }
    },
    {
      "target": "render-export-evidence",
      "type": "progression",
      "label": "Artifact and render evidence",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "post_execution_audit"
          }
        ]
      }
    },
    {
      "target": "pre-handoff-verification",
      "type": "progression",
      "label": "Final pre-handoff gate",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "final_verification"
          }
        ]
      }
    }
  ]
}
