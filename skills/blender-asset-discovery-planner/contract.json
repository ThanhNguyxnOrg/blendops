{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "blender-asset-discovery-planner",
  "version": "1.0.0",
  "category": "asset-and-sourcing",
  "role": "asset-strategy-and-source-planner",
  "purpose": "Plan the asset acquisition strategy (procedural, library, generative, photogrammetry) for a Blender scene without installing or executing. Use after the brief, before scene planning.",
  "capabilityTier": "L0",
  "triggers": [
    "what assets do we need",
    "where do the models come from",
    "asset plan before scene planning",
    "do we generate or import",
    "surface asset license risks before planning"
  ],
  "exclusions": [
    {
      "condition": "the user supplied all assets in the brief (skip; route directly to planner)",
      "delegateTo": "intent-to-3d-brief-writer",
      "reason": "skip; route directly to planner"
    },
    {
      "condition": "runtime is already executing and assets are already in the scene",
      "delegateTo": "product-hero-scene-planner",
      "reason": "route to evidence skill"
    },
    {
      "condition": "the request is iteration on an existing scene (assets are already chosen)",
      "delegateTo": "render-export-evidence",
      "reason": "assets are already chosen"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "locked_3d_brief",
        "type": "object",
        "description": "Structured 3D brief listing required hero subject, props, environment, and materials"
      },
      {
        "name": "target_delivery_channel",
        "type": "string",
        "description": "Target output surface driving geometry and texture fidelity requirements"
      }
    ],
    "optional": [
      {
        "name": "existing_user_assets",
        "type": "array",
        "description": "User-supplied CAD/FBX/OBJ/GLB files or brand texture sets"
      }
    ]
  },
  "outputs": {
    "primary": [
      "asset_sourcing_matrix",
      "procedural_vs_external_split",
      "license_and_budget_risk_register"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "intent-to-3d-brief-writer",
      "type": "upstream_reference",
      "label": "**Before this skill**",
      "when": {
        "all": [
          {
            "field": "goal.clarity",
            "operator": "equals",
            "value": "clear"
          },
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "character-portrait-scene-planner",
      "type": "alternative",
      "label": "**Scene planners (primary handoff with brief + asset plan)** (character-portrait-scene-planner)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "character_portrait"
          }
        ]
      }
    },
    {
      "target": "environment-establishing-shot-planner",
      "type": "alternative",
      "label": "**Scene planners (primary handoff with brief + asset plan)** (environment-establishing-shot-planner)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "environment_shot"
          }
        ]
      }
    },
    {
      "target": "interior-architectural-scene-planner",
      "type": "alternative",
      "label": "**Scene planners (primary handoff with brief + asset plan)** (interior-architectural-scene-planner)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "interior_archviz"
          }
        ]
      }
    },
    {
      "target": "product-grid-scene-planner",
      "type": "alternative",
      "label": "**Scene planners (primary handoff with brief + asset plan)** (product-grid-scene-planner)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "product_grid"
          }
        ]
      }
    },
    {
      "target": "product-hero-scene-planner",
      "type": "alternative",
      "label": "**Scene planners (primary handoff with brief + asset plan)** (product-hero-scene-planner)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "product_hero"
          }
        ]
      }
    },
    {
      "target": "asset-license-checker",
      "type": "progression",
      "label": "**License verdicts**",
      "when": {
        "all": [
          {
            "field": "assets.externalUsed",
            "operator": "equals",
            "value": true
          },
          {
            "field": "assets.licenseCleared",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "asset-style-consistency-checker",
      "type": "progression",
      "label": "**Style re-checks**",
      "when": {
        "all": [
          {
            "field": "assets.licenseCleared",
            "operator": "equals",
            "value": true
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "style_check"
          }
        ]
      }
    },
    {
      "target": "glb-mobile-performance-budget",
      "type": "progression",
      "label": "**Budget reconciliation** (glb-mobile-performance-budget)",
      "when": {
        "all": [
          {
            "field": "artifact.type",
            "operator": "equals",
            "value": "glb"
          },
          {
            "field": "budget.pinned",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "polycount-budget-checker",
      "type": "progression",
      "label": "**Budget reconciliation** (polycount-budget-checker)",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "polycount"
          },
          {
            "field": "budget.verdict",
            "operator": "equals",
            "value": "Not Run"
          }
        ]
      }
    },
    {
      "target": "official-runtime-readiness-checker",
      "type": "upstream_reference",
      "label": "**Generative readiness**",
      "when": {
        "all": [
          {
            "field": "runtime.path",
            "operator": "not_equals",
            "value": "unselected"
          },
          {
            "field": "runtime.verifiedReady",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "asset-fallback-strategy",
      "type": "fallback",
      "label": "**Fallback / constraint updates** (asset-fallback-strategy)",
      "when": {
        "all": [
          {
            "field": "assets.fallbackNeeded",
            "operator": "equals",
            "value": true
          }
        ]
      }
    }
  ]
}
