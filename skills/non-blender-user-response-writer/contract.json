{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "non-blender-user-response-writer",
  "version": "1.0.0",
  "category": "evidence-and-handoff",
  "role": "plain-language-final-response-translator",
  "purpose": "Convert technical Blender workflow findings into plain-language user-facing responses with honest caveats.",
  "capabilityTier": "L0",
  "triggers": [
    "write final user summary",
    "explain this for non-Blender user",
    "make this stakeholder-friendly"
  ],
  "exclusions": [
    {
      "condition": "to hide blockers, drop caveats for readability, or overclaim runtime or artifact success",
      "delegateTo": "render-export-evidence",
      "reason": "Delegates out-of-scope requests to render-export-evidence"
    },
    {
      "condition": "to upgrade Runtime or Artifact truth states",
      "delegateTo": "blender-scene-quality-checker",
      "reason": "Delegates out-of-scope requests to blender-scene-quality-checker"
    },
    {
      "condition": "to classify raw artifact evidence",
      "delegateTo": "render-export-evidence",
      "reason": "use render-export-evidence"
    },
    {
      "condition": "to generate technical pass/warn/fail checks",
      "delegateTo": "blender-scene-quality-checker",
      "reason": "use blender-scene-quality-checker or domain quality checkers"
    },
    {
      "condition": "to assemble technical GLB/web compatibility summaries",
      "delegateTo": "glb-web-handoff",
      "reason": "use glb-web-handoff"
    },
    {
      "condition": "to gate handoff readiness",
      "delegateTo": "pre-handoff-verification",
      "reason": "use pre-handoff-verification"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "verified_workflow_and_evidence_state",
        "type": "object",
        "description": "Final pre-handoff verification gate status, runtime truth state, and artifact truth state"
      },
      {
        "name": "deliverable_summary_inputs",
        "type": "object",
        "description": "Technical outputs from scene planners, quality checkers, or handoff packagers to translate"
      }
    ],
    "optional": [
      {
        "name": "stakeholder_audience_profile",
        "type": "string",
        "description": "Target reader role (product manager, web developer, creative director, end user)"
      }
    ]
  },
  "outputs": {
    "primary": [
      "plain_language_stakeholder_response",
      "explicit_runtime_and_artifact_status_block",
      "jargon_free_next_steps"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "render-export-evidence",
      "type": "upstream_reference",
      "label": "Upstream artifact evidence classification",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "post_execution_audit"
          }
        ]
      }
    },
    {
      "target": "blender-scene-quality-checker",
      "type": "fallback",
      "label": "Upstream quality pass/warn/fail validation (blender-scene-quality-checker)",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "holistic"
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "quality_validation"
          }
        ]
      }
    },
    {
      "target": "composition-quality-checker",
      "type": "fallback",
      "label": "Upstream quality pass/warn/fail validation (composition-quality-checker)",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "composition"
          },
          {
            "field": "quality.verdict",
            "operator": "equals",
            "value": "not_run"
          }
        ]
      }
    },
    {
      "target": "lighting-quality-checker",
      "type": "fallback",
      "label": "Upstream quality pass/warn/fail validation (lighting-quality-checker)",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "lighting"
          },
          {
            "field": "quality.verdict",
            "operator": "equals",
            "value": "not_run"
          }
        ]
      }
    },
    {
      "target": "material-quality-checker",
      "type": "fallback",
      "label": "Upstream quality pass/warn/fail validation (material-quality-checker)",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "material"
          },
          {
            "field": "quality.verdict",
            "operator": "equals",
            "value": "not_run"
          }
        ]
      }
    },
    {
      "target": "polycount-budget-checker",
      "type": "fallback",
      "label": "Upstream quality pass/warn/fail validation (polycount-budget-checker)",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "polycount"
          },
          {
            "field": "budget.verdict",
            "operator": "equals",
            "value": "Not Run"
          }
        ]
      }
    },
    {
      "target": "glb-web-handoff",
      "type": "upstream_reference",
      "label": "Upstream GLB/web handoff summary",
      "when": {
        "all": [
          {
            "field": "artifact.type",
            "operator": "equals",
            "value": "glb"
          },
          {
            "field": "handoff.consumerStack",
            "operator": "equals",
            "value": "web_glb"
          }
        ]
      }
    },
    {
      "target": "pre-handoff-verification",
      "type": "upstream_reference",
      "label": "Upstream handoff gate check",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "final_verification"
          }
        ]
      }
    },
    {
      "target": "official-runtime-readiness-checker",
      "type": "upstream_reference",
      "label": "Runtime readiness check when runtime is unverified",
      "when": {
        "all": [
          {
            "field": "runtime.path",
            "operator": "not_equals",
            "value": "unselected"
          },
          {
            "field": "runtime.verifiedReady",
            "operator": "equals",
            "value": false
          }
        ]
      }
    }
  ]
}
