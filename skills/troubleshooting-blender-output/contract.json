{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "troubleshooting-blender-output",
  "version": "2.0.0",
  "category": "quality-validators",
  "role": "blender-output-troubleshooting",
  "purpose": "Diagnose wrong-looking renders, exports, and runtime errors in plain language and route to the fix without claiming results.",
  "capabilityTier": "L0",
  "triggers": [
    "the render looks wrong",
    "the GLB doesn't open / looks empty / is wrong scale",
    "the output doesn't match what I asked for",
    "why did it produce X instead of Y?",
    "debug this Blender output"
  ],
  "exclusions": [
    {
      "condition": "the user has not yet stated a clear expected outcome (run scoping-3d-briefs first)",
      "delegateTo": "scoping-3d-briefs",
      "reason": "run scoping-3d-briefs first"
    },
    {
      "condition": "runtime has never been attempted (run setting-up-blender-runtime first)",
      "delegateTo": "setting-up-blender-runtime",
      "reason": "run setting-up-blender-runtime first"
    },
    {
      "condition": "the request is creative iteration (\"can we make it more dramatic\"), not debugging",
      "delegateTo": "scoping-3d-briefs",
      "reason": "Delegates out-of-scope requests to scoping-3d-briefs"
    },
    {
      "condition": "the user wants a one-shot fix without diagnostic discipline",
      "delegateTo": "scoping-3d-briefs",
      "reason": "Delegates out-of-scope requests to scoping-3d-briefs"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "observed_symptom_or_error",
        "type": "string",
        "description": "Observed render defect, broken GLB export, scale mismatch, or MCP execution failure"
      },
      {
        "name": "active_workflow_context",
        "type": "object",
        "description": "Current scene plan, runtime path, and recent actions preceding the failure"
      }
    ],
    "optional": [
      {
        "name": "runtime_attempt_notes",
        "type": "string",
        "description": "Optional error output or attempt timeline from verifying-before-handoff"
      }
    ]
  },
  "outputs": {
    "primary": [
      "root_cause_classification",
      "minimal_remediation_plan",
      "reverification_target_skill"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "scoping-3d-briefs",
      "type": "upstream_reference",
      "label": "If divergence at intent (scoping-3d-briefs)",
      "when": {
        "all": [
          {
            "field": "goal.clarity",
            "operator": "equals",
            "value": "ambiguous_or_mixed"
          }
        ]
      }
    },
    {
      "target": "scoping-3d-briefs",
      "type": "upstream_reference",
      "label": "If divergence at intent (scoping-3d-briefs)",
      "when": {
        "all": [
          {
            "field": "goal.clarity",
            "operator": "equals",
            "value": "clear"
          },
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "planning-camera-and-framing",
      "type": "conditional",
      "label": "If divergence at planning (planning-camera-and-framing)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "camera_planning"
          }
        ]
      }
    },
    {
      "target": "planning-lighting-and-materials",
      "type": "conditional",
      "label": "If divergence at planning (planning-lighting-and-materials)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "lookdev_planning"
          }
        ]
      }
    },
    {
      "target": "planning-scenes",
      "type": "alternative",
      "label": "If divergence at planning (planning-scenes)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "character_portrait"
          }
        ]
      }
    },
    {
      "target": "planning-scenes",
      "type": "alternative",
      "label": "If divergence at planning (planning-scenes)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "environment_shot"
          }
        ]
      }
    },
    {
      "target": "planning-scenes",
      "type": "alternative",
      "label": "If divergence at planning (planning-scenes)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "interior_archviz"
          }
        ]
      }
    },
    {
      "target": "planning-product-scenes",
      "type": "alternative",
      "label": "If divergence at planning (planning-product-scenes)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "product_grid"
          }
        ]
      }
    },
    {
      "target": "planning-product-scenes",
      "type": "alternative",
      "label": "If divergence at planning (planning-product-scenes)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "product_hero"
          }
        ]
      }
    },
    {
      "target": "setting-up-blender-runtime",
      "type": "upstream_reference",
      "label": "If divergence at execution (setting-up-blender-runtime)",
      "when": {
        "all": [
          {
            "field": "runtime.path",
            "operator": "not_equals",
            "value": "unselected"
          },
          {
            "field": "runtime.verifiedReady",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "setting-up-blender-runtime",
      "type": "fallback",
      "label": "If divergence at execution (setting-up-blender-runtime)",
      "when": {
        "all": [
          {
            "field": "runtime.conflictDetected",
            "operator": "equals",
            "value": true
          }
        ]
      }
    },
    {
      "target": "setting-up-blender-runtime",
      "type": "upstream_reference",
      "label": "If divergence at execution (setting-up-blender-runtime)",
      "when": {
        "all": [
          {
            "field": "runtime.path",
            "operator": "equals",
            "value": "unselected"
          }
        ]
      }
    },
    {
      "target": "handing-off-glb-to-web",
      "type": "conditional",
      "label": "If divergence at output (handing-off-glb-to-web)",
      "when": {
        "all": [
          {
            "field": "artifact.hasAnimation",
            "operator": "equals",
            "value": true
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "animation_handoff"
          }
        ]
      }
    },
    {
      "target": "handing-off-glb-to-web",
      "type": "conditional",
      "label": "If divergence at output (handing-off-glb-to-web)",
      "when": {
        "all": [
          {
            "field": "artifact.type",
            "operator": "equals",
            "value": "glb"
          },
          {
            "field": "handoff.consumerStack",
            "operator": "equals",
            "value": "web_glb"
          }
        ]
      }
    },
    {
      "target": "verifying-before-handoff",
      "type": "conditional",
      "label": "If divergence at output (verifying-before-handoff)",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "post_execution_audit"
          }
        ]
      }
    },
    {
      "target": "using-blendops",
      "type": "conditional",
      "label": "If divergence at response",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "final_communication"
          }
        ]
      }
    }
  ]
}
