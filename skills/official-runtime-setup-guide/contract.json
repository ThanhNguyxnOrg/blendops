{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "official-runtime-setup-guide",
  "version": "1.0.0",
  "category": "runtime-and-execution",
  "role": "path-1-and-2-setup-instructor",
  "purpose": "Establish official runtime prerequisites and setup boundaries before any Blender execution claim.",
  "capabilityTier": "L0",
  "triggers": [
    "set up Blender runtime prerequisites",
    "what are the Blender runtime setup boundaries",
    "prepare Official Blender Lab MCP setup prerequisites",
    "runtime prerequisites and version minimums"
  ],
  "exclusions": [
    {
      "condition": "to install or configure a runtime automatically",
      "delegateTo": "runtime-path-picker",
      "reason": "Delegates out-of-scope requests to runtime-path-picker"
    },
    {
      "condition": "to claim runtime execution has already succeeded",
      "delegateTo": "path-one-host-outline",
      "reason": "Delegates out-of-scope requests to path-one-host-outline"
    },
    {
      "condition": "to choose a runtime path",
      "delegateTo": "official-runtime-readiness-checker",
      "reason": "official-runtime-readiness-checker"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "selected_runtime_path",
        "type": "string",
        "description": "Chosen execution path from runtime-path-picker (Path 1 Lab MCP, Path 2 mcp-for-blender, or CLI appendix)"
      },
      {
        "name": "host_client_environment",
        "type": "string",
        "description": "User MCP host application (Claude Desktop Connector, Claude Code, Cursor, Windsurf, or manual client)"
      }
    ],
    "optional": [
      {
        "name": "installed_blender_version",
        "type": "string",
        "description": "Installed Blender version used to check the Blender 5.1+ floor for Path 1 vs 3.0+ for Path 2"
      }
    ]
  },
  "outputs": {
    "primary": [
      "step_by_step_setup_prerequisites",
      "path_version_and_host_boundary_notes",
      "readiness_verification_handoff"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "runtime-path-picker",
      "type": "upstream_reference",
      "label": "Path selection",
      "when": {
        "all": [
          {
            "field": "runtime.path",
            "operator": "equals",
            "value": "unselected"
          }
        ]
      }
    },
    {
      "target": "path-one-host-outline",
      "type": "progression",
      "label": "Path 1 host (a)/(b) details",
      "when": {
        "all": [
          {
            "field": "runtime.path",
            "operator": "equals",
            "value": "path_1"
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "runtime_setup"
          }
        ]
      }
    },
    {
      "target": "cli-appendix-job-outline",
      "type": "progression",
      "label": "CLI appendix job structure",
      "when": {
        "all": [
          {
            "field": "runtime.path",
            "operator": "equals",
            "value": "cli_appendix"
          },
          {
            "field": "request.topic",
            "operator": "equals",
            "value": "cli_batch"
          }
        ]
      }
    },
    {
      "target": "runtime-bridge-conflict-resolver",
      "type": "fallback",
      "label": "Bridge conflict resolution",
      "when": {
        "all": [
          {
            "field": "runtime.conflictDetected",
            "operator": "equals",
            "value": true
          }
        ]
      }
    },
    {
      "target": "official-runtime-readiness-checker",
      "type": "progression",
      "label": "Readiness matrix check",
      "when": {
        "all": [
          {
            "field": "runtime.path",
            "operator": "not_equals",
            "value": "unselected"
          },
          {
            "field": "runtime.verifiedReady",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "product-hero-scene-planner",
      "type": "alternative",
      "label": "Scene planning after readiness",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "product_hero"
          }
        ]
      }
    }
  ]
}
