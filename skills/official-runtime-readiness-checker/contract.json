{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "official-runtime-readiness-checker",
  "version": "1.0.0",
  "category": "runtime-and-execution",
  "role": "runtime-connection-and-version-preflight",
  "purpose": "Evaluate whether official runtime appears ready using evidence-bound checks and explicit readiness states.",
  "capabilityTier": "L0",
  "triggers": [
    "check runtime readiness",
    "is runtime available",
    "can we run this now",
    "run the readiness matrix for our chosen Blender path"
  ],
  "exclusions": [
    {
      "condition": "as proof that Blender ran or that runtime execution succeeded",
      "delegateTo": "runtime-path-picker",
      "reason": "Delegates out-of-scope requests to runtime-path-picker"
    },
    {
      "condition": "as a substitute for runtime truth states (Not Run | Attempted | Produced | Verified | Failed) or artifact status (default Not Produced)",
      "delegateTo": "path-one-host-outline",
      "reason": "default Not Produced"
    },
    {
      "condition": "to choose a runtime path",
      "delegateTo": "path-one-host-outline",
      "reason": "use path-one-host-outline"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "selected_runtime_path",
        "type": "string",
        "description": "Target runtime path to verify (Path 1 Official Blender Lab MCP 5.1+, Path 2 mcp-for-blender 3.0+, or CLI appendix)"
      },
      {
        "name": "observed_environment_signals",
        "type": "object",
        "description": "Observed Blender version, enabled add-on state, MCP host configuration, and tool surface signals"
      }
    ],
    "optional": [
      {
        "name": "port_or_session_diagnostics",
        "type": "object",
        "description": "Optional port 9876 listener status or active Blender session count"
      }
    ]
  },
  "outputs": {
    "primary": [
      "runtime_readiness_matrix",
      "readiness_verdict_and_missing_prerequisites",
      "preserved_not_run_truth_state_block"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "runtime-path-picker",
      "type": "upstream_reference",
      "label": "If runtime path is not yet chosen",
      "when": {
        "all": [
          {
            "field": "runtime.path",
            "operator": "equals",
            "value": "unselected"
          }
        ]
      }
    },
    {
      "target": "path-one-host-outline",
      "type": "upstream_reference",
      "label": "If Path 1 host (a) or (b) outline is needed",
      "when": {
        "all": [
          {
            "field": "runtime.path",
            "operator": "equals",
            "value": "path_1"
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "runtime_setup"
          }
        ]
      }
    },
    {
      "target": "official-runtime-setup-guide",
      "type": "fallback",
      "label": "If prerequisites/boundaries are missing (Blocked / Unknown)",
      "when": {
        "all": [
          {
            "field": "runtime.path",
            "operator": "not_equals",
            "value": "unselected"
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "runtime_setup"
          }
        ]
      }
    },
    {
      "target": "runtime-bridge-conflict-resolver",
      "type": "fallback",
      "label": "If bridge contention is detected",
      "when": {
        "all": [
          {
            "field": "runtime.conflictDetected",
            "operator": "equals",
            "value": true
          }
        ]
      }
    },
    {
      "target": "cli-appendix-job-outline",
      "type": "upstream_reference",
      "label": "If CLI appendix job structure is needed",
      "when": {
        "all": [
          {
            "field": "runtime.path",
            "operator": "equals",
            "value": "cli_appendix"
          },
          {
            "field": "request.topic",
            "operator": "equals",
            "value": "cli_batch"
          }
        ]
      }
    },
    {
      "target": "product-hero-scene-planner",
      "type": "alternative",
      "label": "If Ready / Partially Ready and moving to scene planning (product-hero-scene-planner)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "product_hero"
          }
        ]
      }
    },
    {
      "target": "workflow-stage-router",
      "type": "conditional",
      "label": "If Ready / Partially Ready and moving to scene planning (workflow-stage-router)",
      "when": {
        "all": [
          {
            "field": "preflight.passed",
            "operator": "equals",
            "value": true
          },
          {
            "field": "inventory.exists",
            "operator": "equals",
            "value": true
          }
        ]
      }
    }
  ]
}
