{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "runtime-attempt-report",
  "version": "1.0.0",
  "category": "runtime-and-execution",
  "role": "execution-attempt-provenance-logger",
  "purpose": "Produce an evidence-bound runtime attempt report with truth labels and next steps; does not certify upstream stack success.",
  "capabilityTier": "L0",
  "triggers": [
    "write up what we tried",
    "runtime attempt log",
    "postmortem blender connect",
    "evidence report template"
  ],
  "exclusions": [
    {
      "condition": "Classifying rendered or exported visual artifacts (render-export-evidence)",
      "delegateTo": "render-export-evidence",
      "reason": "render-export-evidence"
    },
    {
      "condition": "Diagnosing systematic runtime or scene defects (blender-troubleshooting)",
      "delegateTo": "blender-troubleshooting",
      "reason": "blender-troubleshooting"
    },
    {
      "condition": "Running pre-attempt environment checks (runtime-readiness)",
      "delegateTo": "runtime-readiness",
      "reason": "runtime-readiness"
    },
    {
      "condition": "Selecting which runtime path to use before an attempt (runtime-path-picker)",
      "delegateTo": "runtime-path-picker",
      "reason": "runtime-path-picker"
    },
    {
      "condition": "Performing final release or delivery gating (pre-handoff-verification)",
      "delegateTo": "pre-handoff-verification",
      "reason": "pre-handoff-verification"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "attempted_runtime_path_and_host",
        "type": "object",
        "description": "Path 1, Path 2, or CLI appendix route and MCP host configuration used during the attempt"
      },
      {
        "name": "chronological_execution_log",
        "type": "array",
        "description": "Timestamped sequence of read-only or mutation tool calls, responses, and observed outcomes"
      },
      {
        "name": "version_stamps",
        "type": "object",
        "description": "Exact Blender version, add-on version, and MCP client version strings"
      }
    ],
    "optional": [
      {
        "name": "pre_mutation_backup_record",
        "type": "object",
        "description": "Optional .blend checkpoint backup metadata if an L1+ mutation was attempted"
      }
    ]
  },
  "outputs": {
    "primary": [
      "structured_runtime_attempt_report_md",
      "locked_runtime_and_artifact_truth_labels",
      "eval_evidence_archival_path"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "runtime-readiness",
      "type": "upstream_reference",
      "label": "Pre-attempt readiness check",
      "when": {
        "all": [
          {
            "field": "runtime.path",
            "operator": "not_equals",
            "value": "unselected"
          },
          {
            "field": "runtime.verifiedReady",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "runtime-path-picker",
      "type": "upstream_reference",
      "label": "Runtime path selection context",
      "when": {
        "all": [
          {
            "field": "runtime.path",
            "operator": "equals",
            "value": "unselected"
          }
        ]
      }
    },
    {
      "target": "bridge-conflicts",
      "type": "fallback",
      "label": "Bridge / port / host conflicts",
      "when": {
        "all": [
          {
            "field": "runtime.conflictDetected",
            "operator": "equals",
            "value": true
          }
        ]
      }
    },
    {
      "target": "blender-troubleshooting",
      "type": "fallback",
      "label": "Runtime or scene defect diagnosis",
      "when": {
        "all": [
          {
            "field": "runtime.errorDetected",
            "operator": "equals",
            "value": true
          }
        ]
      }
    },
    {
      "target": "render-export-evidence",
      "type": "progression",
      "label": "Artifact evidence classification",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "post_execution_audit"
          }
        ]
      }
    },
    {
      "target": "pre-handoff-verification",
      "type": "fallback",
      "label": "Final handoff gate & failure exit",
      "when": {
        "any": [
          {
            "field": "gate.status",
            "operator": "equals",
            "value": "failed"
          },
          {
            "field": "runtime.mode",
            "operator": "equals",
            "value": "blocked"
          }
        ]
      }
    }
  ]
}
