{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "glb-animation-handoff",
  "version": "1.0.0",
  "category": "evidence-and-handoff",
  "role": "rig-and-animation-clip-handoff-planner",
  "purpose": "Document GLB animation contract (skeletal vs morph, FPS, looping, root motion, blend transitions) with truthful caveats for web playback.",
  "capabilityTier": "L0",
  "triggers": [
    "make it loop",
    "trigger animation on hover",
    "idle and active states",
    "smooth transition between"
  ],
  "exclusions": [
    {
      "condition": "static GLBs with no animation",
      "delegateTo": "glb-web-handoff",
      "reason": "Delegates out-of-scope requests to glb-web-handoff"
    },
    {
      "condition": "video pre-renders",
      "delegateTo": "output-format-decision",
      "reason": "Delegates out-of-scope requests to output-format-decision"
    },
    {
      "condition": "platforms that re-author animation downstream (game engines re-rigging the asset)",
      "delegateTo": "product-hero-scene-planner",
      "reason": "game engines re-rigging the asset"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "animation_clip_inventory",
        "type": "array",
        "description": "List of NLA/action clips with frame lengths, FPS, and skeletal/morph types"
      },
      {
        "name": "interactive_playback_triggers",
        "type": "object",
        "description": "Target loop/one-shot semantics, crossfade durations, root-motion policy, and consumer triggers"
      }
    ],
    "optional": [
      {
        "name": "mobile_rig_budget_ceilings",
        "type": "object",
        "description": "Bone count, morph target, and keyframe channel ceilings from glb-mobile-performance-budget"
      }
    ]
  },
  "outputs": {
    "primary": [
      "per_clip_animation_contract_table",
      "root_motion_and_interpolation_pins",
      "consumer_playback_verification_checklist"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "character-portrait-scene-planner",
      "type": "upstream_reference",
      "label": "Missing clip list / scene plan (character-portrait-scene-planner)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "character_portrait"
          }
        ]
      }
    },
    {
      "target": "environment-establishing-shot-planner",
      "type": "upstream_reference",
      "label": "Missing clip list / scene plan (environment-establishing-shot-planner)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "environment_shot"
          }
        ]
      }
    },
    {
      "target": "interior-architectural-scene-planner",
      "type": "upstream_reference",
      "label": "Missing clip list / scene plan (interior-architectural-scene-planner)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "interior_archviz"
          }
        ]
      }
    },
    {
      "target": "product-grid-scene-planner",
      "type": "upstream_reference",
      "label": "Missing clip list / scene plan (product-grid-scene-planner)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "product_grid"
          }
        ]
      }
    },
    {
      "target": "product-hero-scene-planner",
      "type": "upstream_reference",
      "label": "Missing clip list / scene plan (product-hero-scene-planner)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "product_hero"
          }
        ]
      }
    },
    {
      "target": "glb-mobile-performance-budget",
      "type": "upstream_reference",
      "label": "Channel, bone, and morph ceilings",
      "when": {
        "all": [
          {
            "field": "artifact.type",
            "operator": "equals",
            "value": "glb"
          },
          {
            "field": "budget.pinned",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "render-export-evidence",
      "type": "upstream_reference",
      "label": "Export verification",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "post_execution_audit"
          }
        ]
      }
    },
    {
      "target": "glb-web-handoff",
      "type": "progression",
      "label": "Web delivery handoff",
      "when": {
        "all": [
          {
            "field": "artifact.type",
            "operator": "equals",
            "value": "glb"
          },
          {
            "field": "handoff.consumerStack",
            "operator": "equals",
            "value": "web_glb"
          }
        ]
      }
    },
    {
      "target": "three-fiber-component-shape-planner",
      "type": "progression",
      "label": "React Three Fiber component shape",
      "when": {
        "all": [
          {
            "field": "artifact.type",
            "operator": "equals",
            "value": "glb"
          },
          {
            "field": "handoff.consumerStack",
            "operator": "equals",
            "value": "react_three_fiber"
          }
        ]
      }
    },
    {
      "target": "non-blender-user-response-writer",
      "type": "progression",
      "label": "Final user-facing wording",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "final_communication"
          }
        ]
      }
    }
  ]
}
