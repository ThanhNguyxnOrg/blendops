{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "blendops-look-check",
  "version": "2.0.0",
  "category": "runtime-and-execution",
  "role": "preview-look-check-loop",
  "purpose": "Check a built preview with read-only numeric checks, captures from several views and a visual review, fixing one issue per round through blendops-build for at most three rounds.",
  "capabilityTier": "L0",
  "triggers": [
    "check how the preview looks",
    "does it look right",
    "the preview looks wrong",
    "something is floating",
    "the object is cut off in the shot",
    "compare the preview with the brief",
    "check it from other angles",
    "fix what looks off before the final render"
  ],
  "exclusions": [
    {
      "condition": "no preview or build exists yet",
      "delegateTo": "blendops-build",
      "reason": "build and preview first"
    },
    {
      "condition": "the final render or GLB must be verified and labelled for handoff",
      "delegateTo": "blendops-final-check",
      "reason": "final evidence and truth labels are owned by blendops-final-check"
    },
    {
      "condition": "no runtime path is ready",
      "delegateTo": "blendops-connect-blender",
      "reason": "check readiness first"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "locked_scene_plan",
        "type": "object",
        "description": "Approved plan: object names, sizes, grounded objects, lights, camera, output settings"
      },
      {
        "name": "preview_record",
        "type": "object",
        "description": "Preview output from blendops-build: image path or tool result and runtime path"
      }
    ],
    "optional": [
      {
        "name": "look_criteria",
        "type": "array",
        "description": "Look criteria from blendops-done-criteria"
      },
      {
        "name": "reference_images",
        "type": "array",
        "description": "Reference images from the brief"
      }
    ]
  },
  "outputs": {
    "primary": [
      "numeric_check_report",
      "multi_view_capture_record",
      "visual_issue_list",
      "per_round_fix_record",
      "look_verdict",
      "plain_language_look_summary"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "blendops-final-check",
      "type": "progression",
      "label": "No fail left; check the preview against the done criteria",
      "when": {
        "all": [
          {
            "field": "quality.verdict",
            "operator": "in",
            "value": [
              "pass",
              "warn"
            ]
          }
        ]
      }
    },
    {
      "target": "blendops-build",
      "type": "conditional",
      "label": "A fail was found within three rounds; fix it with one build step and check again",
      "when": {
        "all": [
          {
            "field": "quality.verdict",
            "operator": "equals",
            "value": "fail"
          },
          {
            "field": "runtime.errorDetected",
            "operator": "equals",
            "value": false
          },
          {
            "field": "gate.status",
            "operator": "not_equals",
            "value": "blocked"
          }
        ]
      }
    },
    {
      "target": "blendops-fix-problems",
      "type": "conditional",
      "label": "A check or capture failed, or an issue came back after its fix",
      "when": {
        "all": [
          {
            "field": "runtime.errorDetected",
            "operator": "equals",
            "value": true
          }
        ]
      }
    },
    {
      "target": "blendops-connect-blender",
      "type": "fallback",
      "label": "Runtime is not ready for checks",
      "when": {
        "all": [
          {
            "field": "runtime.verifiedReady",
            "operator": "equals",
            "value": false
          }
        ]
      }
    }
  ]
}
