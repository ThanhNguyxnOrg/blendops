{
  "$schema": "../../schemas/skill-contract.schema.json",
  "id": "blendops-glb-web-handoff",
  "version": "2.0.0",
  "category": "evidence-and-handoff",
  "role": "glb-web-animation-and-r3f-handoff",
  "purpose": "Prepare GLB handoff to web teams, including animation clips and a React Three Fiber component plan.",
  "capabilityTier": "L0",
  "triggers": [
    "prepare web handoff",
    "is GLB ready",
    "summarize export status",
    "make it loop",
    "trigger animation on hover",
    "idle and active states",
    "smooth transition between",
    "how should the React component look",
    "what props should I expose",
    "ref shape for the model",
    "we use react-three-fiber"
  ],
  "exclusions": [
    {
      "condition": "to claim GLB or export success without concrete evidence",
      "delegateTo": "blendops-final-check",
      "reason": "Delegates out-of-scope requests to blendops-final-check"
    },
    {
      "condition": "to replace runtime export verification",
      "delegateTo": "blendops-final-check",
      "reason": "Delegates out-of-scope requests to blendops-final-check"
    },
    {
      "condition": "to validate upstream scene readiness",
      "delegateTo": "blendops-final-check",
      "reason": "use blendops-final-check"
    },
    {
      "condition": "to classify raw render/export artifact evidence",
      "delegateTo": "blendops-final-check",
      "reason": "use blendops-final-check"
    },
    {
      "condition": "to define mobile or file-size performance budgets",
      "delegateTo": "blendops-glb-budget",
      "reason": "use blendops-glb-budget"
    },
    {
      "condition": "to write the final user-facing response wording",
      "delegateTo": "blendops-start",
      "reason": "use blendops-start"
    },
    {
      "condition": "video pre-renders",
      "delegateTo": "blendops-render-settings",
      "reason": "Delegates out-of-scope requests to blendops-render-settings"
    },
    {
      "condition": "platforms that re-author animation downstream (game engines re-rigging the asset)",
      "delegateTo": "blendops-product-shot",
      "reason": "game engines re-rigging the asset"
    },
    {
      "condition": "the GLB is rendered server-side (e.g. AR pre-render); no React component needed",
      "delegateTo": "blendops-start",
      "reason": "Delegates out-of-scope requests to blendops-start"
    }
  ],
  "inputs": {
    "required": [
      {
        "name": "verified_or_planned_glb_artifact",
        "type": "object",
        "description": "GLB artifact evidence record (from blendops-final-check) or planned export specification"
      },
      {
        "name": "target_web_viewer_stack",
        "type": "string",
        "description": "Target web runtime (Three.js, React Three Fiber, <model-viewer>, Babylon.js)"
      }
    ],
    "optional": [
      {
        "name": "animation_and_budget_contracts",
        "type": "object",
        "description": "Optional linked contracts from blendops-glb-web-handoff and blendops-glb-budget"
      },
      {
        "name": "animation_clip_inventory",
        "type": "array",
        "description": "List of NLA/action clips with frame lengths, FPS, and skeletal/morph types"
      },
      {
        "name": "interactive_playback_triggers",
        "type": "object",
        "description": "Target loop/one-shot semantics, crossfade durations, root-motion policy, and consumer triggers"
      },
      {
        "name": "mobile_rig_budget_ceilings",
        "type": "object",
        "description": "Bone count, morph target, and keyframe channel ceilings from blendops-glb-budget"
      },
      {
        "name": "glb_delivery_contract",
        "type": "object",
        "description": "Locked GLB node hierarchy, material slots, and compression spec from blendops-glb-web-handoff"
      },
      {
        "name": "r3f_version_and_use_case",
        "type": "object",
        "description": "Target @react-three/fiber major version (8 vs 9) and interactive component use case"
      },
      {
        "name": "animation_clip_contract",
        "type": "object",
        "description": "Optional clip names, triggers, and crossfade rules from blendops-glb-web-handoff"
      }
    ]
  },
  "outputs": {
    "primary": [
      "web_glb_delivery_handoff_packet",
      "scale_orientation_and_compression_manifest",
      "viewer_integration_caveats",
      "per_clip_animation_contract_table",
      "root_motion_and_interpolation_pins",
      "consumer_playback_verification_checklist",
      "r3f_component_props_and_ref_spec",
      "suspense_caching_and_dispose_contract",
      "consumer_call_site_usage_outline"
    ],
    "truthStatePolicy": {
      "runtimeDefault": "Not Run",
      "artifactDefault": "Not Produced",
      "mutationRule": "downgrade_only"
    }
  },
  "handoffs": [
    {
      "target": "blendops-final-check",
      "type": "upstream_reference",
      "label": "Upstream scene readiness validation",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "holistic"
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "quality_validation"
          }
        ]
      }
    },
    {
      "target": "blendops-final-check",
      "type": "upstream_reference",
      "label": "Upstream artifact evidence classification",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "post_execution_audit"
          }
        ]
      }
    },
    {
      "target": "blendops-glb-budget",
      "type": "upstream_reference",
      "label": "Mobile and file-size budget constraints",
      "when": {
        "all": [
          {
            "field": "artifact.type",
            "operator": "equals",
            "value": "glb"
          },
          {
            "field": "budget.pinned",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "blendops-start",
      "type": "conditional",
      "label": "Final user-facing response wording",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "final_communication"
          }
        ]
      }
    },
    {
      "target": "blendops-scene-plan",
      "type": "upstream_reference",
      "label": "Missing clip list / scene plan (blendops-scene-plan)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "character_portrait"
          }
        ]
      }
    },
    {
      "target": "blendops-scene-plan",
      "type": "upstream_reference",
      "label": "Missing clip list / scene plan (blendops-scene-plan)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "environment_shot"
          }
        ]
      }
    },
    {
      "target": "blendops-scene-plan",
      "type": "upstream_reference",
      "label": "Missing clip list / scene plan (blendops-scene-plan)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "interior_archviz"
          }
        ]
      }
    },
    {
      "target": "blendops-product-shot",
      "type": "upstream_reference",
      "label": "Missing clip list / scene plan (blendops-product-shot)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "product_grid"
          }
        ]
      }
    },
    {
      "target": "blendops-product-shot",
      "type": "upstream_reference",
      "label": "Missing clip list / scene plan (blendops-product-shot)",
      "when": {
        "all": [
          {
            "field": "brief.locked",
            "operator": "equals",
            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "product_hero"
          }
        ]
      }
    },
    {
      "target": "blendops-lighting-materials",
      "type": "upstream_reference",
      "label": "Color and material checks (blendops-lighting-materials)",
      "when": {
        "all": [
          {
            "field": "decision.colorLocked",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "target": "blendops-lighting-materials",
      "type": "upstream_reference",
      "label": "Color and material checks (blendops-lighting-materials)",
      "when": {
        "all": [
          {
            "field": "quality.domain",
            "operator": "equals",
            "value": "material"
          },
          {
            "field": "quality.verdict",
            "operator": "equals",
            "value": "not_run"
          }
        ]
      }
    }
  ]
}
