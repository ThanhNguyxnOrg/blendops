{
  "schema_version": "1.0.0",
  "id": "scene-spec.stylized-environment-diorama",
  "title": "Stylized Floating Lantern Shrine Isometric Diorama",
  "language": "en",
  "intent": {
    "summary": "Build a stylized isometric environment diorama featuring a stone lantern shrine, modular wooden bridge, and stylized foliage with atmospheric depth and Cycles AgX rendering.",
    "primary_goal": "environment_or_diorama_scene",
    "target_audience_or_platform": "Portfolio environment art showcase and high-resolution desktop wallpaper",
    "workflow_entry_stage": "discover",
    "explicit_recipe_override": null
  },
  "blender_version_target": {
    "min": "4.0",
    "tested_range": "4.0 - 5.1",
    "recommended": "5.1"
  },
  "runtime_preference": {
    "preferred_path": "path-1-official-blender-lab-mcp",
    "allow_cli_fallback": true
  },
  "objects_and_subjects": [
    {
      "id": "lantern_shrine_focal",
      "name": "Stone_Lantern_Shrine",
      "role": "hero",
      "source_type": "hard_surface_modeled",
      "poly_budget_triangles": 35000,
      "transforms_applied": true,
      "scale_factors": [1.0, 1.0, 1.0],
      "uv_strategy": "single_0_1_atlas",
      "modifiers": ["Bevel", "WeightedNormal"],
      "has_non_manifold_or_scan_noise": false
    },
    {
      "id": "diorama_island_base",
      "name": "Floating_Island_Terrain",
      "role": "environment",
      "source_type": "sculpted_or_retopologized",
      "poly_budget_triangles": 60000,
      "transforms_applied": true,
      "scale_factors": [1.0, 1.0, 1.0],
      "uv_strategy": "single_0_1_atlas",
      "modifiers": [],
      "has_non_manifold_or_scan_noise": false
    },
    {
      "id": "stylized_foliage_cluster",
      "name": "Pine_And_Moss_Instances",
      "role": "secondary",
      "source_type": "procedural_geometry_nodes",
      "poly_budget_triangles": 80000,
      "transforms_applied": true,
      "scale_factors": [1.0, 1.0, 1.0],
      "uv_strategy": "single_0_1_atlas",
      "modifiers": ["Nodes"],
      "has_non_manifold_or_scan_noise": false
    }
  ],
  "style_and_materials": {
    "aesthetic_style": "Stylized hand-crafted PBR diorama with warm lantern emission and mossy stone roughness variation",
    "shader_workflow": "principled_bsdf_pbr",
    "uv_packing": "single_0_1_atlas",
    "udim_tile_count": 1,
    "bake_procedural_to_pbr": true,
    "channel_packing": "orm_rgb",
    "max_texture_resolution": 2048,
    "normal_map_space": "tangent_mikktspace"
  },
  "lighting_and_environment": {
    "rig_type": "sun_sky_exterior",
    "key_to_fill_ratio": 4.0,
    "hdri_lighting": true,
    "volumetric_effects": {
      "enabled": true,
      "bake_or_card_fallback_for_realtime": true
    }
  },
  "camera_and_framing": {
    "focal_length_mm": 50,
    "sensor_width_mm": 36,
    "aspect_ratio": "16:9",
    "resolution_px": {
      "width": 3840,
      "height": 2160
    },
    "depth_of_field": {
      "enabled": true,
      "f_stop": 4.0
    },
    "clip_start_m": 0.1,
    "clip_end_m": 500.0,
    "framing_style": "Foreground/midground/background layered diorama framing with warm focal contrast"
  },
  "render_and_color": {
    "engine": "CYCLES",
    "view_transform": "AgX",
    "look": "AgX - High Contrast",
    "samples": 512,
    "denoiser": "OPENIMAGEDENOISE"
  },
  "animation_and_rigging": {
    "enabled": false,
    "has_armature": false,
    "max_bone_influences_per_vertex": 0,
    "bake_nla_to_linear_keyframes": false,
    "has_shape_keys": false,
    "apply_modifiers_with_shape_keys": false,
    "frame_rate_fps": 24,
    "frame_range": [1, 1]
  },
  "simulation_and_vfx": {
    "enabled": true,
    "simulation_types": ["geometry_nodes_scatter"],
    "geometry_nodes_realize_instances": true,
    "bake_to_alembic_or_keyframes": false
  },
  "optimization_and_budgets": {
    "target_tier": "offline_cinema",
    "max_triangles": 250000,
    "max_draw_calls": 80,
    "max_vram_mb": 1024,
    "max_file_size_mb": 80.0,
    "mesh_compression": "none",
    "texture_compression": "png_jpeg",
    "generate_lods": false
  },
  "deliverables": {
    "formats": ["png_still", "exr_multilayer"],
    "target_consumers": ["offline_compositor"],
    "requires_standard_khronos_gltf_2_0": false
  },
  "quality_gates": [
    "Foreground, midground, and background depth layers read clearly in silhouette",
    "Camera near/far clip planes tightly bound scene depth to prevent Z-fighting",
    "AgX view transform preserves warm lantern emission without whiteout clipping"
  ],
  "truth_state_defaults": {
    "runtime_status": "Not Run",
    "artifact_status": "Not Produced"
  }
}
