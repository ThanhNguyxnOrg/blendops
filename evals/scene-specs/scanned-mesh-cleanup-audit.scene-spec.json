{
  "schema_version": "1.0.0",
  "id": "scene-spec.scanned-mesh-cleanup-audit",
  "title": "Photogrammetry Ceramic Vase Scan Audit, Manifold Cleanup & Retopology",
  "language": "en",
  "intent": {
    "summary": "Inspect and remediate a raw photogrammetry ceramic vase mesh containing non-manifold holes, flipped normals, and unapplied transforms, then retopologize and bake clean PBR maps.",
    "primary_goal": "scene_quality_inspection_and_cleanup",
    "target_audience_or_platform": "3D QA pipeline and museum digital archive viewer",
    "workflow_entry_stage": "verify",
    "explicit_recipe_override": null
  },
  "blender_version_target": {
    "min": "3.6",
    "tested_range": "3.6 - 5.1",
    "recommended": "5.1"
  },
  "runtime_preference": {
    "preferred_path": "path-1-official-blender-lab-mcp",
    "allow_cli_fallback": true
  },
  "objects_and_subjects": [
    {
      "id": "scanned_ceramic_vase",
      "name": "Ceramic_Vase_Scan_Cleaned",
      "role": "scanned_source",
      "source_type": "photogrammetry_scan",
      "poly_budget_triangles": 24000,
      "transforms_applied": true,
      "scale_factors": [1.0, 1.0, 1.0],
      "uv_strategy": "single_0_1_atlas",
      "modifiers": ["Shrinkwrap"],
      "has_non_manifold_or_scan_noise": true
    }
  ],
  "style_and_materials": {
    "aesthetic_style": "Archival glazed stoneware with baked high-to-low normal and roughness maps",
    "shader_workflow": "principled_bsdf_pbr",
    "uv_packing": "single_0_1_atlas",
    "udim_tile_count": 1,
    "bake_procedural_to_pbr": true,
    "channel_packing": "orm_rgb",
    "max_texture_resolution": 2048,
    "normal_map_space": "tangent_mikktspace"
  },
  "lighting_and_environment": {
    "rig_type": "three_point_studio",
    "key_to_fill_ratio": 2.0,
    "hdri_lighting": true,
    "volumetric_effects": {
      "enabled": false,
      "bake_or_card_fallback_for_realtime": false
    }
  },
  "camera_and_framing": {
    "focal_length_mm": 85,
    "sensor_width_mm": 36,
    "aspect_ratio": "4:5",
    "resolution_px": {
      "width": 1600,
      "height": 2000
    },
    "depth_of_field": {
      "enabled": false,
      "f_stop": 8.0
    },
    "clip_start_m": 0.05,
    "clip_end_m": 25.0,
    "framing_style": "Orthogonal archival inspection views"
  },
  "render_and_color": {
    "engine": "CYCLES",
    "view_transform": "AgX",
    "look": "AgX - Base Contrast",
    "samples": 128,
    "denoiser": "OPENIMAGEDENOISE"
  },
  "animation_and_rigging": {
    "enabled": false,
    "has_armature": false,
    "max_bone_influences_per_vertex": 0,
    "bake_nla_to_linear_keyframes": false,
    "has_shape_keys": false,
    "apply_modifiers_with_shape_keys": false,
    "frame_rate_fps": 30,
    "frame_range": [1, 1]
  },
  "simulation_and_vfx": {
    "enabled": false,
    "simulation_types": [],
    "geometry_nodes_realize_instances": false,
    "bake_to_alembic_or_keyframes": false
  },
  "optimization_and_budgets": {
    "target_tier": "desktop_web",
    "max_triangles": 30000,
    "max_draw_calls": 5,
    "max_vram_mb": 64,
    "max_file_size_mb": 6.0,
    "mesh_compression": "draco",
    "texture_compression": "ktx2_basisu",
    "generate_lods": false
  },
  "deliverables": {
    "formats": ["inspection_audit_report", "glb_web_standard", "png_still"],
    "target_consumers": ["qa_pipeline", "threejs_r3f"],
    "requires_standard_khronos_gltf_2_0": true
  },
  "quality_gates": [
    "Zero non-manifold boundary edges, zero internal faces, and consistent outward face normals",
    "All floating scan noise islands removed and base contacts seated at Z = 0",
    "Orphaned datablocks purged and missing external texture paths resolved"
  ],
  "truth_state_defaults": {
    "runtime_status": "Not Run",
    "artifact_status": "Not Produced"
  }
}
