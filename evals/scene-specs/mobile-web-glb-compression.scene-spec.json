{
  "schema_version": "1.0.0",
  "id": "scene-spec.mobile-web-glb-compression",
  "title": "Mobile E-Commerce Chair Asset Optimization (< 5 MB, KTX2 + Draco + LODs)",
  "language": "en",
  "intent": {
    "summary": "Optimize an existing high-poly lounge chair asset for mobile web viewers (<model-viewer> and Three.js) within a strict 50k triangle, 15 draw call, 64 MB VRAM, and 4.5 MB file size budget using KTX2 and Draco.",
    "primary_goal": "web_glb_optimization_and_handoff",
    "target_audience_or_platform": "Mobile Safari / Android Chrome AR & <model-viewer> e-commerce embed",
    "workflow_entry_stage": "plan",
    "explicit_recipe_override": null
  },
  "blender_version_target": {
    "min": "3.6",
    "tested_range": "3.6 - 5.1",
    "recommended": "5.1"
  },
  "runtime_preference": {
    "preferred_path": "path-2-community-mcp-for-blender",
    "allow_cli_fallback": true
  },
  "objects_and_subjects": [
    {
      "id": "lounge_chair_mobile",
      "name": "Lounge_Chair_LOD0",
      "role": "hero",
      "source_type": "existing_asset",
      "poly_budget_triangles": 38000,
      "transforms_applied": true,
      "scale_factors": [1.0, 1.0, 1.0],
      "uv_strategy": "single_0_1_atlas",
      "modifiers": ["Decimate", "WeightedNormal"],
      "has_non_manifold_or_scan_noise": false
    }
  ],
  "style_and_materials": {
    "aesthetic_style": "Mid-century walnut wood and bouclé fabric baked into a single 2K ORM + BaseColor + Normal atlas",
    "shader_workflow": "principled_bsdf_pbr",
    "uv_packing": "single_0_1_atlas",
    "udim_tile_count": 1,
    "bake_procedural_to_pbr": true,
    "channel_packing": "orm_rgb",
    "max_texture_resolution": 2048,
    "normal_map_space": "tangent_mikktspace"
  },
  "lighting_and_environment": {
    "rig_type": "hdri_environment",
    "key_to_fill_ratio": 2.5,
    "hdri_lighting": true,
    "volumetric_effects": {
      "enabled": false,
      "bake_or_card_fallback_for_realtime": false
    }
  },
  "camera_and_framing": {
    "focal_length_mm": 50,
    "sensor_width_mm": 36,
    "aspect_ratio": "1:1",
    "resolution_px": {
      "width": 1024,
      "height": 1024
    },
    "depth_of_field": {
      "enabled": false,
      "f_stop": 8.0
    },
    "clip_start_m": 0.05,
    "clip_end_m": 20.0,
    "framing_style": "Mobile product viewer thumbnail framing"
  },
  "render_and_color": {
    "engine": "BLENDER_EEVEE_NEXT",
    "view_transform": "AgX",
    "look": "AgX - Base Contrast",
    "samples": 64,
    "denoiser": "NONE"
  },
  "animation_and_rigging": {
    "enabled": false,
    "has_armature": false,
    "max_bone_influences_per_vertex": 0,
    "bake_nla_to_linear_keyframes": false,
    "has_shape_keys": false,
    "apply_modifiers_with_shape_keys": false,
    "frame_rate_fps": 30,
    "frame_range": [1, 1]
  },
  "simulation_and_vfx": {
    "enabled": false,
    "simulation_types": [],
    "geometry_nodes_realize_instances": false,
    "bake_to_alembic_or_keyframes": false
  },
  "optimization_and_budgets": {
    "target_tier": "mobile_web",
    "max_triangles": 50000,
    "max_draw_calls": 15,
    "max_vram_mb": 64,
    "max_file_size_mb": 4.5,
    "mesh_compression": "draco",
    "texture_compression": "ktx2_basisu",
    "generate_lods": true
  },
  "deliverables": {
    "formats": ["glb_web_standard"],
    "target_consumers": ["model_viewer", "threejs_r3f"],
    "requires_standard_khronos_gltf_2_0": true
  },
  "quality_gates": [
    "Total triangles <= 50,000, draw calls <= 15, and uncompressed GPU VRAM <= 64 MB",
    "Textures compressed with KTX2 BasisU (UASTC for normal/ORM, ETC1S for base color)",
    "LOD0/LOD1/LOD2 generated with pinned UV seam boundaries"
  ],
  "truth_state_defaults": {
    "runtime_status": "Not Run",
    "artifact_status": "Not Produced"
  }
}
