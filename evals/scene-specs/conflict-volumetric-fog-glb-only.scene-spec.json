{
  "schema_version": "1.0.0",
  "id": "scene-spec.conflict-volumetric-fog-glb-only",
  "title": "Conflicting Cycles Volumetric Fog + Unbaked Procedural Shader for Web GLB-Only Delivery",
  "language": "en",
  "intent": {
    "summary": "Deliver a web-only standard GLB file that relies on Cycles Principle Volume fog without card/bake fallback and unbaked Blender procedural Noise/Musgrave shader nodes.",
    "primary_goal": "web_glb_optimization_and_handoff",
    "target_audience_or_platform": "Mobile web <model-viewer> embed",
    "workflow_entry_stage": "plan",
    "explicit_recipe_override": null
  },
  "blender_version_target": {
    "min": "4.0",
    "tested_range": "4.0 - 5.1",
    "recommended": "5.1"
  },
  "runtime_preference": {
    "preferred_path": "path-1-official-blender-lab-mcp",
    "allow_cli_fallback": true
  },
  "objects_and_subjects": [
    {
      "id": "volumetric_swamp_orb",
      "name": "Volumetric_Swamp_Orb",
      "role": "hero",
      "source_type": "procedural_geometry_nodes",
      "poly_budget_triangles": 85000,
      "transforms_applied": true,
      "scale_factors": [1.0, 1.0, 1.0],
      "uv_strategy": "single_0_1_atlas",
      "modifiers": ["Nodes"],
      "has_non_manifold_or_scan_noise": false
    }
  ],
  "style_and_materials": {
    "aesthetic_style": "Dense procedural volumetric fog with unbaked procedural Voronoi/Noise nodes",
    "shader_workflow": "procedural_nodes_unbaked",
    "uv_packing": "single_0_1_atlas",
    "udim_tile_count": 1,
    "bake_procedural_to_pbr": false,
    "channel_packing": "none",
    "max_texture_resolution": 2048,
    "normal_map_space": "tangent_mikktspace"
  },
  "lighting_and_environment": {
    "rig_type": "hdri_environment",
    "key_to_fill_ratio": 2.0,
    "hdri_lighting": true,
    "volumetric_effects": {
      "enabled": true,
      "bake_or_card_fallback_for_realtime": false
    }
  },
  "camera_and_framing": {
    "focal_length_mm": 50,
    "sensor_width_mm": 36,
    "aspect_ratio": "1:1",
    "resolution_px": {
      "width": 1024,
      "height": 1024
    },
    "depth_of_field": {
      "enabled": false,
      "f_stop": 8.0
    },
    "clip_start_m": 0.0001,
    "clip_end_m": 100000.0,
    "framing_style": "Centered orb view"
  },
  "render_and_color": {
    "engine": "CYCLES",
    "view_transform": "AgX",
    "look": "AgX - Base Contrast",
    "samples": 128,
    "denoiser": "OPENIMAGEDENOISE"
  },
  "animation_and_rigging": {
    "enabled": false,
    "has_armature": false,
    "max_bone_influences_per_vertex": 0,
    "bake_nla_to_linear_keyframes": false,
    "has_shape_keys": false,
    "apply_modifiers_with_shape_keys": false,
    "frame_rate_fps": 30,
    "frame_range": [1, 1]
  },
  "simulation_and_vfx": {
    "enabled": true,
    "simulation_types": ["smoke_fire_mantaflow", "geometry_nodes_scatter"],
    "geometry_nodes_realize_instances": false,
    "bake_to_alembic_or_keyframes": false
  },
  "optimization_and_budgets": {
    "target_tier": "mobile_web",
    "max_triangles": 40000,
    "max_draw_calls": 10,
    "max_vram_mb": 48,
    "max_file_size_mb": 4.0,
    "mesh_compression": "draco",
    "texture_compression": "ktx2_basisu",
    "generate_lods": false
  },
  "deliverables": {
    "formats": ["glb_web_standard"],
    "target_consumers": ["model_viewer"],
    "requires_standard_khronos_gltf_2_0": true
  },
  "quality_gates": [
    "Volumetric fog and procedural shaders appear identical in <model-viewer>",
    "Exported GLB stays under 40k triangles"
  ],
  "truth_state_defaults": {
    "runtime_status": "Not Run",
    "artifact_status": "Not Produced"
  }
}
