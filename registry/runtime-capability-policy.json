{
  "$schema": "../schemas/runtime-capability-policy.schema.json",
  "schemaVersion": "1.0.0",
  "defaultCapabilityTier": "L0",
  "runtimeExecutionState": {
    "blenderRuntime": "Not Run",
    "liveRollbackEngineExecuted": false,
    "honestyNote": "BlendOps is a portable content and governance layer. This policy defines and validates L0-L3 capability boundaries and pre-mutation .blend backup requirements without claiming that a live Blender rollback execution engine ran inside this repository."
  },
  "tiers": {
    "L0": {
      "id": "L0",
      "rank": 0,
      "name": "Planning & Read-Only Inspection",
      "summary": "Default tier for all BlendOps skills. Permits pure workflow planning, validation, and read-only MCP inspection (get_blendfile_summary_datablocks, get_objects_summary, get_scene_info) with zero scene mutations and zero file writes.",
      "allowSceneMutation": false,
      "allowFileExport": false,
      "allowExternalAssetImport": false,
      "allowArbitraryCodeExecution": false,
      "requiresPreMutationBlendBackup": false,
      "requiresExplicitOperatorConfirmation": false,
      "requiresAssetLicenseClearance": false,
      "userFacingPythonAllowed": false
    },
    "L1": {
      "id": "L1",
      "rank": 1,
      "name": "Reversible Scene Mutation",
      "summary": "Permits bounded camera, lighting, material, and object transform mutations inside an active Blender scene only after a verified pre-mutation .blend checkpoint backup is saved on disk.",
      "allowSceneMutation": true,
      "allowFileExport": false,
      "allowExternalAssetImport": false,
      "allowArbitraryCodeExecution": false,
      "requiresPreMutationBlendBackup": true,
      "requiresExplicitOperatorConfirmation": false,
      "requiresAssetLicenseClearance": false,
      "userFacingPythonAllowed": false
    },
    "L2": {
      "id": "L2",
      "rank": 2,
      "name": "File Export & External Asset Import",
      "summary": "Permits rendering still/turntable outputs, exporting .glb containers to an allowlisted output directory, and importing external 3D/material assets cleared by asset-license-checker.",
      "allowSceneMutation": true,
      "allowFileExport": true,
      "allowExternalAssetImport": true,
      "allowArbitraryCodeExecution": false,
      "requiresPreMutationBlendBackup": true,
      "requiresExplicitOperatorConfirmation": false,
      "requiresAssetLicenseClearance": true,
      "userFacingPythonAllowed": false
    },
    "L3": {
      "id": "L3",
      "rank": 3,
      "name": "Arbitrary Code / Destructive Operations",
      "summary": "Governs headless CLI batch execution or destructive multi-object operations. Requires explicit operator confirmation, verified pre-execution .blend backup, and strict compliance with laws/no-arbitrary-python-interface.md.",
      "allowSceneMutation": true,
      "allowFileExport": true,
      "allowExternalAssetImport": true,
      "allowArbitraryCodeExecution": true,
      "requiresPreMutationBlendBackup": true,
      "requiresExplicitOperatorConfirmation": true,
      "requiresAssetLicenseClearance": true,
      "userFacingPythonAllowed": false
    }
  },
  "rollbackProtocol": {
    "checkpointPattern": "<scene>.pre-<skill-id>-<ISO8601-UTC>.blend",
    "requiredBackupFields": [
      "sourceBlendPath",
      "backupPath",
      "byteSize",
      "sha256",
      "createdBeforeMutation",
      "verifiedOnDisk"
    ],
    "failClosedOnBackupFailure": true,
    "recoveryVerificationTools": {
      "path1": [
        "get_blendfile_summary_datablocks",
        "get_objects_summary"
      ],
      "path2": [
        "get_scene_info",
        "get_object_info"
      ]
    },
    "postRecoveryTruthRule": "If a scene mutation fails and the pre-mutation .blend backup is restored, the operation must be reported as Runtime status: Failed (or Attempted) with rollback verified, and Artifact status: Not Produced."
  },
