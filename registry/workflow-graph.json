            "value": true
          },
          {
            "field": "recipe.domain",
            "operator": "equals",
            "value": "interior_archviz"
          }
        ]
      }
    },
    {
      "from": "workflow-stage-router",
      "to": "pack-prerequisite-checker",
      "type": "upstream_reference",
      "label": "Pack entry preflight gate",
      "when": {
        "all": [
          {
            "field": "preflight.passed",
            "operator": "equals",
            "value": false
          }
        ]
      }
    },
    {
      "from": "workflow-stage-router",
      "to": "official-runtime-readiness-checker",
      "type": "conditional",
      "label": "Runtime readiness check",
      "when": {
        "all": [
          {
            "field": "runtime.status",
            "operator": "equals",
            "value": "Not Run"
          },
          {
            "field": "stage.requiresRuntime",
            "operator": "equals",
            "value": true
          }
        ]
      }
    },
    {
      "from": "workflow-stage-router",
      "to": "runtime-bridge-conflict-resolver",
      "type": "fallback",
      "label": "Active MCP bridge conflict on port 9876",
      "when": {
        "all": [
          {
            "field": "runtime.conflictDetected",
            "operator": "equals",
            "value": true
          }
        ]
      }
    },
    {
      "from": "workflow-stage-router",
      "to": "blender-scope-boundary-enforcer",
      "type": "boundary_delegation",
      "label": "Mid-workflow scope expansion or unapproved deliverable addition",
      "when": {
        "all": [
          {
            "field": "scope.driftDetected",
            "operator": "equals",
            "value": true
          }
        ]
      }
    },
    {
      "from": "workflow-stage-router",
      "to": "render-export-evidence",
      "type": "progression",
      "label": "Evidence updates for render or export outputs",
      "when": {
        "all": [
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "post_execution_audit"
          }
        ]
      }
    },
    {
      "from": "workflow-stage-router",
      "to": "pre-handoff-verification",
      "type": "fallback",
      "label": "Failed gate / blocked mode exit / final gate",
      "when": {
        "any": [
          {
            "field": "gate.status",
            "operator": "equals",
            "value": "failed"
          },
          {
            "field": "runtime.mode",
            "operator": "equals",
            "value": "blocked"
          },
          {
            "field": "stage.current",
            "operator": "equals",
            "value": "final_verification"
          }
        ]
      }
    }
  ]
}
