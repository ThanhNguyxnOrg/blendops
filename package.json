{
  "name": "blendops",
  "version": "1.0.0",
  "private": true,
  "description": "AI-native Blender workflow, knowledge catalog, and portable skill pack for non-Blender users. Ships 48 Anthropic Skills, 4 hard guardrail laws, 10 canonical recipes, deterministic SceneSpec/ExecutionPlan compilation, MCP runtime qualification, GLB inspection, and 26+ agent install targets.",
  "homepage": "https://github.com/ThanhNguyxnOrg/blendops#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ThanhNguyxnOrg/blendops.git"
  },
  "bugs": {
    "url": "https://github.com/ThanhNguyxnOrg/blendops/issues"
  },
  "license": "MIT",
  "keywords": [
    "blender",
    "blender-mcp",
    "claude",
    "claude-skills",
    "anthropic-skills",
    "openai-skills",
    "ai-agent",
    "mcp",
    "model-context-protocol",
    "workflow",
    "3d",
    "glb",
    "non-blender-user"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "blendops": "bin/blendops.mjs"
  },
  "files": [
    "bin/",
    "scripts/install-skills.mjs",
    "scripts/build-knowledge-catalog.mjs",
    "scripts/compile-scene-plan.mjs",
    "scripts/runtime-orchestrator.mjs",
    "scripts/validate-capability-policy.mjs",
    "scripts/validate-evidence-packet.mjs",
    "scripts/export-claude-skills.mjs",
    "scripts/inspect-glb.mjs",
    "scripts/generate-glb-handoff-report.mjs",
    "docs/knowledge-and-recipe-catalog.md",
    "docs/recipes/",
    "docs/workflows/",
    "docs/examples/glb-web-handoff/",
    "skills/",
    "laws/",
    "packs/",
    "bundles/generic-project-local/",
    "bundles/claude-desktop-manual/",
    "bundles/skill-package/",
    "registry/",
    "schemas/",
    "skills.sh.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "start": "node scripts/dev-server.mjs",
    "build": "npm run ci",
    "catalog:build": "node scripts/build-knowledge-catalog.mjs --build",
    "catalog:check": "node scripts/build-knowledge-catalog.mjs --check",
    "catalog:eval": "node scripts/build-knowledge-catalog.mjs --eval",
    "plan:compile": "node scripts/compile-scene-plan.mjs",
    "operations:check": "node scripts/runtime-orchestrator.mjs --check",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "evals:build": "node scripts/run-evals.mjs --build",
    "evals:check": "node scripts/run-evals.mjs --check",
    "evals:list": "node scripts/run-evals.mjs --list",
    "evals:run": "node scripts/run-evals.mjs",
    "bundles:summaries:build": "node scripts/generate-bundle-reference-summaries.mjs",
    "bundles:summaries:check": "node scripts/generate-bundle-reference-summaries.mjs --check",
    "skills:install": "node scripts/install-skills.mjs",
    "glb:inspect": "node scripts/inspect-glb.mjs",
    "glb:handoff": "node scripts/generate-glb-handoff-report.mjs",
    "arch:build": "node scripts/validate-repository-architecture.mjs",
    "arch:check": "node scripts/validate-repository-architecture.mjs --check",
    "test": "node --test scripts/test-skills-export.mjs scripts/test-routing-contracts.mjs scripts/test-behavioral-evals.mjs scripts/test-skill-templates.mjs scripts/test-catalog-contracts.mjs scripts/test-eval-coverage.mjs scripts/test-adapter-matrix.mjs scripts/test-bundle-summaries.mjs scripts/test-dev-server.mjs scripts/test-project-installer.mjs scripts/test-cli-package.mjs scripts/test-glb-handoff.mjs scripts/test-repository-architecture.mjs scripts/test-knowledge-catalog.mjs scripts/test-scene-spec-harmonizer.mjs scripts/test-runtime-orchestrator.mjs scripts/test-runtime-hardening.mjs scripts/test-mcp-qualification.mjs scripts/test-mcp-client-skills-sh.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "skills:export": "node scripts/export-claude-skills.mjs",
    "ci": "npm run docs:check && npm run catalog:check && npm run operations:check && npm run arch:check && npm run registry:check && npm run evals:check && npm run evals:run && npm run bundles:summaries:check && npm run skills:export && npm test",
    "audit:sync-digest": "node scripts/sync-current-audit-digest.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {}
}
